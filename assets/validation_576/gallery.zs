// Galería aislada de #471; no define materiales, recetas ni fuentes jugables.
class CA471Gallery : StaticEventHandler
{
    int Selected, View;
    bool Ready;
    Actor Objects[11];
    String Names[11];
    String Icons[11];
    void Focus(CaelumPlayer u)
    {
        double angle = View*90;
        double distance = Selected>=9 ? 66 : 43;
        Vector3 center = Objects[Selected].Pos;
        u.SetOrigin(center-(cos(angle)*distance,sin(angle)*distance,0),false);
        u.Angle=angle;u.Pitch=Selected>=9?30:42;
    }
    override void NetworkProcess(ConsoleEvent e)
    {
        let u=CaelumPlayer(players[e.Player].mo);if(u==null)return;
        if(e.Name=="ca471_setup")
        {
            u.bInvulnerable=true;u.DebugAttributesAt100=true;u.ApplyCharacterProfile();
            u.CreationWizardOpen=false;u.GrantMagicBoxFromPalomo(false);
            u.CurrentThirst=100;u.CurrentHunger=100;u.CurrentSleep=100;
            u.CurrentAir=u.DerivedStats.MaximumAir;u.CurrentAnima=u.DerivedStats.MaximumAnima;
            Setup(u);Ready=true;Selected=0;View=0;Focus(u);
        }
        if(!Ready)return;
        if(e.Name=="ca471_next"){Selected=(Selected+1)%11;View=0;Focus(u);}
        if(e.Name=="ca471_previous"){Selected=(Selected+10)%11;View=0;Focus(u);}
        if(e.Name=="ca471_view"){View=(View+1)%4;Focus(u);}
        if(e.Name=="ca471_select"){Selected=Clamp(e.Args[0],0,10);View=Clamp(e.Args[1],0,3);Focus(u);}
        if(e.Name=="ca471_inventory")
        {
            u.SetCraftingJournalState(true);
            CVar.GetCVar("ca_journal_page",u.player).SetInt(0);
        }
    }
    void Setup(CaelumPlayer u)
    {
        // SETUP GENERATED BY prepare.py
    }
    override void RenderOverlay(RenderEvent e)
    {
        if(!Ready)return;
        let texture=TexMan.CheckForTexture(Icons[Selected],TexMan.Type_MiscPatch);
        if(!texture.IsValid()) { Console.Printf("CA471 FAIL missing gallery icon %s",Icons[Selected]);return; }
        let size=TexMan.GetScaledSize(texture);
        if(size.X<=0 || size.Y<=0) { Console.Printf("CA471 FAIL zero-sized gallery icon %s",Icons[Selected]);return; }
        Screen.Dim(0x181512,.85,12,12,300,190);
        Screen.DrawTexture(texture,false,24,44,DTA_DestWidth,128,DTA_DestHeight,128);
        Screen.DrawText(SmallFont,Font.CR_GOLD,24,22,String.Format("%d / 11  %s",Selected+1,Names[Selected]));
        Screen.DrawText(SmallFont,Font.CR_WHITE,24,178,"F1 siguiente | F2 girar | F3 anterior");
    }
}
