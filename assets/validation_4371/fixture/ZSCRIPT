        Issue62Check.Assert(CaelumMainM00MagicTrial.Complete(u),"Caella completes trial");
        u.player.ConversationNPC=null;
        Issue62Check.Assert(r.QuestStage[0]==CaelumConstants.MAIN_M00_STATE_CAELLA_COMPLETE&&r.HasMainM00Flag(CaelumConstants.MAIN_M00_FLAG_SECRET_PASSAGE_OPEN),"stage 45 and secret passage unlocked");
