    override bool Use(bool pickup)
    {
        let u=CaelumPlayer(Owner); u.StopSealChannel(true); let r=u.GetPersistentCharacterState(true);
        Issue62Check.Assert(r.IsMainM00MagicPracticeComplete(),"all five practices completed");
        u.player.ConversationNPC=Issue62Check.Speaker();
        Issue62Check.Assert(!CaelumMainM00MagicTrial.Complete(u),"cannot finish before runes");
        CaelumMainM00MagicTrial.UseRune(u,CaelumConstants.ESSENCE_EARTH);
        CaelumMainM00MagicTrial.UseRune(u,CaelumConstants.ESSENCE_FIRE);
        Issue62Check.Assert(r.MainM00RuneSequenceIndex==0&&r.IsMainM00MagicPracticeComplete(),"wrong rune resets only sequence");
