class Issue62Check : Object play
{
    static void Assert(bool ok, String label)
    { Console.Printf("QA62 %s %s",ok?"PASS":"FAIL",label); }
    static int Targets()
    {
        int count=0; let it=ThinkerIterator.Create("CaelumM00TrainingDummy");
        while(it.Next()!=null) count++;
        return count;
    }
    static CaelumCaella Speaker()
    { let it=ThinkerIterator.Create("CaelumCaella"); return CaelumCaella(it.Next()); }
    static void ClearShots()
    {
        let it=ThinkerIterator.Create("CaelumPlayerMagicProjectile"); Actor a;
        while((a=Actor(it.Next()))!=null) a.Destroy();
    }
    static void ClearHits(CaelumPlayer u)
    {
        ClearShots();
        let r=u.GetPersistentCharacterState(true);
        r.MainM00Flag[CaelumConstants.MAIN_M00_FLAG_MAGIC_PRIMARY_USED]=false;
        r.MainM00Flag[CaelumConstants.MAIN_M00_FLAG_MAGIC_SECONDARY_USED]=false;
        u.CancelPendingStaffCast(false);
    }
    static void Aim(CaelumPlayer u, double angle=90)
    {
        vector3 p=CaelumMansionPracticeData.Position();
        u.SetOrigin((p.X,p.Y-88,p.Z),false); u.Vel=(0,0,0); u.Angle=angle;
        // Aim at the body's centre from the native projectile release height.
        u.Pitch=atan2(u.Height*0.65-36,88-32);
        u.CurrentAnima=u.DerivedStats.MaximumAnima;
        // Control random aim only in the isolated fixture, never in production.
        u.DerivedStats.MagicalAccuracyPercent=10000;
    }
    static void Dump(CaelumPlayer u, String label)
    {
        let r=u.GetPersistentCharacterState(true);
        Console.Printf("QA62 STATE %s stage=%d primary=%d secondary=%d channel=%d spent=%d recovered=%d runes=%d targets=%d weapon=%d seal=%d",label,r.QuestStage[0],r.MainM00Flag[11],r.MainM00Flag[12],r.MainM00Flag[13],r.MainM00Flag[57],r.MainM00Flag[58],r.MainM00RuneSequenceIndex,Targets(),u.ActiveWeaponItemId,u.EquippedSealItemId);
    }
}
