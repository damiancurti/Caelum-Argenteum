class Issue62DelayedRunner : Actor
{
    CaelumPlayer User;int Age;bool Switched;
    override void Tick()
    {
        Super.Tick();if(User==null)return;
        User.DerivedStats.MagicalAccuracyPercent=10000;
        if(Age==0){Issue62Check.ClearHits(User);Issue62Check.Aim(User);User.PerformDebugStaffAttack(true);}
        if(!Switched&&!User.StaffCastPending&&User.LastStaffCastCompleted)
        {
            let it=ThinkerIterator.Create("CaelumPlayerMagicProjectile");let shot=CaelumPlayerMagicProjectile(it.Next());
            Issue62Check.Assert(shot!=null,"native spell remains in flight before equipment switch");
            if(shot!=null)shot.Vel*=0.05;
            Issue62Owned.Weapon(User);Switched=true;
        }
        if(Age==150)
        {
            let r=User.GetPersistentCharacterState(true);
            Issue62Check.Assert(Switched&&!r.MainM00Flag[11]&&r.MainM00Flag[12],"delayed spell retains secondary mode after switching to sword");
            Console.Printf("QA62 DELAY_DONE");Destroy();return;
        }
        Age++;
    }
    Default { +NOINTERACTION }
    States { Spawn: TNT1 A -1; Stop; }
}
