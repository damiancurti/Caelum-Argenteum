class Issue62MatrixRunner : Actor
{
    CaelumPlayer User;
    int Age, CaseIndex, WeaponType;
    bool SeenFlight;
    override void Tick()
    {
        Super.Tick(); if(User==null)return;
        User.DerivedStats.MagicalAccuracyPercent=10000;
        int phase=Age%90;
        if(phase==0)
        {
            Issue62Check.ClearHits(User); Issue62Check.Aim(User);
            let item=User.FindNativeEquipmentItemById(User.ActiveWeaponItemId);
            item.ItemType=WeaponType; item.EssenceType=CaseIndex/2;
            item.UnitWeight=User.WeaponModel.GetWeightFor(WeaponType,item.Tier,item.EquipmentSize);
            User.ActivateExactEquippedWeapon(item);
            SeenFlight=false; User.PerformDebugStaffAttack(CaseIndex%2==1);
            Issue62Check.Assert(User.StaffCastPending,"matrix native cast started");
        }
        if(!SeenFlight&&!User.StaffCastPending&&User.LastStaffCastCompleted)
        {
            SeenFlight=true;
            Issue62Check.Assert(User.PendingStaffWeaponType==WeaponType&&User.PendingStaffEssenceType==CaseIndex/2&&User.PendingStaffSecondaryAttack==(CaseIndex%2==1),"native cast metadata matches matrix case");
            let r=User.GetPersistentCharacterState(true);
            Issue62Check.Assert(!r.MainM00Flag[11]&&!r.MainM00Flag[12],"cast release alone does not complete either attack");
        }
        if(phase==89)
        {
            let r=User.GetPersistentCharacterState(true);
            Console.Printf("QA62 MATRIX_DETAIL p=%d s=%d yaw=%.2f pitch=%.2f pos=(%.1f,%.1f,%.1f) angle=%.2f",r.MainM00Flag[11],r.MainM00Flag[12],User.LastStaffYawOffset,User.LastStaffPitchOffset,User.Pos.X,User.Pos.Y,User.Pos.Z,User.Angle);
            Issue62Check.Assert(SeenFlight&&r.MainM00Flag[11]==(CaseIndex%2==0)&&r.MainM00Flag[12]==(CaseIndex%2==1),String.Format("matrix weapon=%d essence=%d secondary=%d",WeaponType,CaseIndex/2,CaseIndex%2));
            CaseIndex++;
            if(CaseIndex==10){Console.Printf("QA62 MATRIX_DONE weapon=%d",WeaponType);Destroy();return;}
        }
        Age++;
    }
    Default { +NOINTERACTION }
    States { Spawn: TNT1 A -1; Stop; }
}
