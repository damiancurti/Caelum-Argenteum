class Issue61View : CaelumSocialDebugAction
{
    override bool Use(bool pickup)
    {
        let u=CaelumPlayer(Owner);
        let r=u.GetPersistentCharacterState(true);
        r.DemoNarrativeDelivered=2047; r.DemoNarrativePending=0;
        u.CharacterCreationComplete=true; u.CreationWizardOpen=false;
        u.bInvulnerable=true; u.bNoGravity=true; u.bNoClip=true;
        u.SetOrigin((-1150,-900,30),false); u.Angle=35; u.Pitch=-4;
        return true;
    }
}
