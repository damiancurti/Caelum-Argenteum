        static const int data[]={0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2};
        return i>=0 && i<24?data[i]:-1;
    }
    static clearscope int TrapSector(int i){
        static const int data[]={6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033};
        return i>=0 && i<24?data[i]:-1;
    }
    static clearscope int At(vector2 p){int x=int(Floor(p.X/CELL)),y=int(Floor(p.Y/CELL));return x<0 || y<0 || x>=GRID || y>=GRID?-1:GridNode(y*GRID+x);}
    static clearscope vector3 HunterStart(){return (3968,3968,0);}
    static clearscope vector3 JusticeCenter(){return (4544,4544,0);}
