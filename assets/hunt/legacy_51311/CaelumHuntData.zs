        static const double axis0[]={32,96,160,224,32,96,160,224};
        static const double axis1[]={96,96,96,96,160,160,160,160};
        static const double axis2[]={0,0,0,0,0,0,0,0};
        return i>=0 && i<8?(axis0[i],axis1[i],axis2[i]):(0,0,0);
    }
    static clearscope vector3 TrapPoint(int i){
        static const double axis0[]={512,1024,1536,512,1024,1536,2560,3072,3584,2560,3072,3584,512,1024,1536,512,1024,1536,2560,3072,3584,2560,3072,3584};
