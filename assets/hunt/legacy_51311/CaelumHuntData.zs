        static const double axis2[]={0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5};
        return i>=0 && i<24?(axis0[i],axis1[i],axis2[i]):(0,0,0);
    }
