            for(int i=0;i<indices.Size();i++)
            {
                int encoded=indices[i];int waterIndex=encoded%540;int lineIndex=encoded/540;
                if(lineIndex>=level.Lines.Size()){bad++;continue;}
                let line=level.Lines[lineIndex];
                let side=line.sidedef[0];
                if(side==null || side.sector.sectornum!=waterIndex)side=line.sidedef[1];
                if(side==null || side.sector.sectornum!=waterIndex){bad++;continue;}
                checked++;
                String expected=candidate?"CA887WET":"CA875WAL";
                if(TexMan.GetName(side.GetTexture(Side.bottom))!=expected)bad++;
            }
            let texture=TexMan.CheckForTexture(candidate?"CA887WET":"CA875WAL",TexMan.Type_Wall);
            let size=TexMan.GetScaledSize(texture);
            okay=okay && size.X==64 && size.Y==64;
            okay=okay && level.Lines.Size()==67124;
        }
        int arena=original?104:539;
        int sectors=original?105:540;
        okay=okay && bad==0 && checked==(original?0:4638) && level.Sectors.Size()==sectors;
        okay=okay && CaelumJusticeGeometry.Get()!=null && CaelumJusticeGeometry.SectorIndex(level.MapName)==arena;
        okay=okay && (CaelumJusticeGeometry.Center(level.MapName)-(8960.0,9984.0,0.0)).Length()<.001;
        Console.Printf("CA887 SURFACE %s candidate=%d default=%d sides=%d bad=%d arena=%d checksum=%s",okay?"PASS":"FAIL",candidate,original,checked,bad,arena,checksum);
    }
    void Place(int index)
    {
        let user=CaelumPlayer(players[0].mo);
        if(user==null){Console.Printf("CA866 FAIL player");return;}
        vector3 point;double angle,pitch;
        switch(index) { case 0: point=(0,-4864,0); angle=90; pitch=0; break;
case 1: point=(-160.0,-4256.0,0); angle=45; pitch=0; break;
case 2: point=(-2304.0,-4128.0,0); angle=0; pitch=0; break;
case 3: point=(-3936.0,-3232.0,0); angle=135; pitch=0; break;
case 4: point=(-2912,8160.0,0); angle=180; pitch=0; break;
case 5: point=(-1536,-3752.0,0); angle=90; pitch=0; break;
case 6: point=(-2504.0,-4048.0,0); angle=0; pitch=0; break;
case 7: point=(-2528.0,-4072.0,0); angle=0; pitch=0; break; default:Console.Printf("CA866 FAIL index");return; }
        user.SetOrigin(point,false);user.FindFloorCeiling();
        user.SetOrigin((point.X,point.Y,user.FloorZ),false);
        user.Angle=angle;user.Pitch=pitch;user.Vel=(0,0,0);
        if(index==6){vector3 target=(-2504.0,-4080.0,-8.0);user.Angle=VectorAngle(target.X-user.Pos.X,target.Y-user.Pos.Y);user.Pitch=VectorAngle((target.XY-user.Pos.XY).Length(),user.Pos.Z+user.ViewHeight-target.Z);}
        if(index==7){vector3 target=(-2496.0,-4072.0,-8.0);user.Angle=VectorAngle(target.X-user.Pos.X,target.Y-user.Pos.Y);user.Pitch=VectorAngle((target.XY-user.Pos.XY).Length(),user.Pos.Z+user.ViewHeight-target.Z);}
        Console.Printf("CA866 VIEW %d pos=%.3f,%.3f,%.3f angle=%.3f headroom=%.3f height=%.3f floor=%s ceiling=%s",index,user.Pos.X,user.Pos.Y,user.Pos.Z,user.Angle,user.CeilingZ-user.FloorZ,user.Height,TexMan.GetName(user.CurSector.GetTexture(Sector.floor)),TexMan.GetName(user.CurSector.GetTexture(Sector.ceiling)));
        if(user.CeilingZ-user.FloorZ<user.Height)Console.Printf("CA866 FAIL clearance");
        if(!user.TestMobjLocation())Console.Printf("CA866 FAIL occupied camera %d",index);
        CheckSurfaces();
    }
    override void NetworkProcess(ConsoleEvent e)
    {
        if(e.Name=="ca866_next"){Place(View);View=(View+1)%8;}
        else if(e.Name=="ca866_walk"){Place(0);WalkStart=players[0].mo.Pos;}
        else if(e.Name=="ca866_done")
        {
            let user=players[0].mo;double distance=(user.Pos-WalkStart).Length();
            Console.Printf("CA866 WALK distance=%.3f pos=%.3f,%.3f,%.3f",distance,user.Pos.X,user.Pos.Y,user.Pos.Z);
            Console.Printf("CA866 %s views=%d",View==8 && distance>0?"PASS":"FAIL",View);
        }
    }
}
