# Generated development packages are rebuilt from src and are not source code.
build/

# GZDoom may create local logs or crash reports during testing.
*.log
*.dmp

# Windows Explorer metadata does not belong in the repository.
Thumbs.db
Desktop.ini

# Los generadores internos de documentos no pertenecen al repositorio del juego.
update_documentation*.py

# Los constructores de mapas importan módulos auxiliares y Python genera esta
# caché local; nunca forma parte del código fuente ni de los parches.
__pycache__/
*.py[cod]
