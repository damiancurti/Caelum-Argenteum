# Generated development packages are rebuilt from src and are not source code.
build/

# GZDoom may create local logs or crash reports during testing.
*.log
*.dmp

# Windows Explorer metadata does not belong in the repository.
Thumbs.db
Desktop.ini

# Internal document generators do not belong in the game repository.
update_documentation*.py

# Map builders import helper modules and Python creates this local cache;
# it never belongs in source code or patches.
__pycache__/
*.py[cod]
