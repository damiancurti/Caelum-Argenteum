// La portada emplea texto real con la tipografía de Caelum. Esto evita los
// parches rasterizados de Doom y convierte el flujo en creación/carga de
// personaje. "Nuevo personaje" abre el creador previo a la partida; al
// confirmar, éste inicia MAP01 con la única clase y dificultad de Caelum.
DefaultListMenu
{
    Font "CaelumText", "Gold"
    Selector "M_SKULL1", -32, -5
    Linespacing 16
}

ListMenu "MainMenu"
{
    StaticPatch 94, 2, "M_DOOM"
    Position 97, 72
    Font "CaelumText", "Gold"
    Linespacing 16

    TextItem "$CA_MENU_NEW_CHARACTER", "n", "CaelumNewCharacterMenu"
    TextItem "$CA_MENU_LOAD_CHARACTER", "l", "LoadGameMenu"
    TextItem "$CA_MENU_SAVE_CHARACTER", "g", "SaveGameMenu"
    TextItem "$MNU_OPTIONS", "o", "OptionsMenu"
    TextItem "$MNU_QUITGAME", "s", "QuitMenu"
}

// La clase ZScript conserva el borrador mientras se recorren las ocho páginas
// y sólo inicia una partida después de validar los 4+30 puntos obligatorios.
ListMenu "CaelumNewCharacterMenu"
{
    Class "CaelumCharacterCreationMenu"
}

// Estos menús deben conservar las clases nativas de carga y guardado.
ListMenu "LoadGameMenu"
{
    NetgameMessage "$LOADNET"
    CaptionItem "$CA_MENU_LOAD_CHARACTER"
    Position 80, 40
    Class "LoadMenu"
    Size Clean
}

ListMenu "SaveGameMenu"
{
    CaptionItem "$CA_MENU_SAVE_CHARACTER"
    Position 80, 40
    Class "SaveMenu"
    Size Clean
}

// GZDoom 4.14.2 fija NewSmallFont desde gzdoom.pk3 para los renglones de
// OptionMenu (incluido Personalizar controles). Un PK3 puede ajustar el
// espaciado, pero no reemplazar esa fuente sin reimplementar dichos menús o
// usar un ejecutable propio.
OptionMenuSettings
{
    Linespacing 12
}
