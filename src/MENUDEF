// La portada emplea texto real con la tipografía de Caelum. Esto evita los
// parches rasterizados de Doom y convierte el flujo en creación/carga de
// personaje. "Nuevo personaje" abre el creador previo a la partida; al
// confirmar, éste inicia MAP01 con la única clase y dificultad de Caelum.
DefaultListMenu
{
    Font "CaelumText", "Gold"
    Selector "M_SKULL1", -30, -6
    Linespacing 16
}

ListMenu "MainMenu"
{
    StaticPatch 94, 2, "M_DOOM"
    Position 97, 72
    Font "CaelumText", "Gold"
    Linespacing 16

    TextItem "$CA_MENU_NEW_CHARACTER", "n", "CaelumNewCharacterMenu"
    TextItem "$CA_MENU_LOAD_CHARACTER", "l", "LoadGameMenu"
    TextItem "$CA_MENU_SAVE_CHARACTER", "g", "SaveGameMenu"
    TextItem "$MNU_OPTIONS", "o", "OptionsMenu"
    TextItem "$MNU_QUITGAME", "s", "CaelumExitMenu"
}

// Reenvío inmediato a la confirmación nativa, con el audio propio de Salir.
ListMenu "CaelumExitMenu"
{
    Class "CaelumExitMenu"
    TextItem "$MNU_QUITGAME", "s", "QuitMenu"
}

// La clase ZScript conserva el borrador mientras se recorren las doce páginas
// y sólo inicia una partida después de validar los 4+30 puntos obligatorios.
ListMenu "CaelumNewCharacterMenu"
{
    Class "CaelumCharacterCreationMenu"
}

// Sólo el creador abre la introducción; cargar una partida no la repite.
ListMenu "CaelumIntroductionMenu"
{
    Class "CaelumIntroductionMenu"
}

// Estos menús deben conservar las clases nativas de carga y guardado.
ListMenu "LoadGameMenu"
{
    NetgameMessage "$LOADNET"
    CaptionItem "$CA_MENU_LOAD_CHARACTER"
    Position 80, 40
    Class "LoadMenu"
    Size Clean
}

ListMenu "SaveGameMenu"
{
    CaptionItem "$CA_MENU_SAVE_CHARACTER"
    Position 80, 40
    Class "SaveMenu"
    Size Clean
}

// GZDoom 4.14.2 fija NewSmallFont desde gzdoom.pk3 para los renglones de
// OptionMenu (incluido Personalizar controles). Un PK3 puede ajustar el
// espaciado, pero no reemplazar esa fuente sin reimplementar dichos menús o
// usar un ejecutable propio.
OptionMenuSettings
{
    Linespacing 12
}

ListMenu "CaelumTrucazoMenu"
{
    Class "CaelumTrucazoMenu"
}

ListMenu "CaelumTrucoMenu"
{
    Class "CaelumTrucoMenu"
}

// AddOptionMenu conserva los ajustes nativos y permite elegir una clase UI
// sin intentar reemplazar la definición protegida de GZDoom 4.14.2.
AddOptionMenu "NewPlayerMenu"
{
    Class "CaelumPlayerPreferencesMenu"
    Submenu "$CA_APPEARANCE_TITLE", "CaelumAppearanceMenu"
    StaticText "$CA_IDENTITY_CREATOR_OWNER"
    StaticText "$CA_IDENTITY_NETWORK_NAME"
}

ListMenu "CaelumAppearanceMenu"
{
    Class "CaelumAppearanceMenu"
}

AddOptionMenu "InventoryControlsMenu"
{
    Control "$CA_CONTROL_JOURNAL", "ca_journal_toggle"
}

AddOptionMenu "InventoryControlsMenu"
{
    Control "$CA_SKIP_TITLE", "ca_time_skip"
}

ListMenu "CaelumLiveMenu"
{
    Class "CaelumLiveMenu"
}

// Las filas usan EnterKey/Bindings y el reset originales del motor.
AddOptionMenu "CustomizeControls"
{
    Submenu "$CA_CONTROL_COMBAT", "CaelumCombatControls"
    Submenu "$CA_CONTROL_ABILITIES", "CaelumAbilityControls"
}
OptionMenu "CaelumCombatControls"
{
    Title "$CA_CONTROL_COMBAT"
    ScrollTop 2
    StaticTextSwitchable "$CNTRLMNU_SWITCHTEXT1", "$CNTRLMNU_SWITCHTEXT2", "ControlMessage"
    StaticText ""
    Control "$CNTRLMNU_ATTACK", "+attack"
    Control "$CNTRLMNU_ALTATTACK", "+altattack"
    Control "$CNTRLMNU_RELOAD", "+reload"
    Control "$CNTRLMNU_ZOOM", "+zoom"
}
OptionMenu "CaelumAbilityControls"
{
    Title "$CA_CONTROL_ABILITIES"
    ScrollTop 2
    StaticTextSwitchable "$CNTRLMNU_SWITCHTEXT1", "$CNTRLMNU_SWITCHTEXT2", "ControlMessage"
    StaticText ""
    Control "$CNTRLMNU_USER1", "+user1"
    Control "$CNTRLMNU_USER2", "+user2"
    Control "$CNTRLMNU_USER3", "+user3"
    Control "$CNTRLMNU_USER4", "+user4"
    StaticText "$CA_CONTROL_RESERVED"
}
AddOptionMenu "MapControlsMenu"
{
    Control "$CNTRLMNU_AUTOMAP", "togglemap"
}
