// Caelum Argenteum — superficies con pasos propios para GZDoom 4.14.2.

Terrain CaelumGrass
{
    StepVolume 0.70
    WalkStepTics 18
    RunStepTics 12
    StepSounds "caelum/player/footstep_grass"
}

Terrain CaelumWood
{
    StepVolume 0.70
    WalkStepTics 18
    RunStepTics 12
    StepSounds "caelum/player/footstep_wood"
}

// #426: tipos declarados para superficies clasificadas; los suelos sin
// material identificado conservan la referencia de piedra/madera.
Terrain CaelumSoil { }
Terrain CaelumMetal { }

Terrain CaelumPoolWater
{
    FootClip 8
    Liquid
}

Floor CMGR01 CaelumGrass
Floor CMGR01A CaelumGrass
Floor CMGR01B CaelumGrass
Floor CMGR01C CaelumGrass
Floor CMWD01 CaelumWood
Floor CAPOOL01 CaelumPoolWater
