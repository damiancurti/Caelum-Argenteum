namespace = "GZDoom";

// CA_DLG_M01_PALOMO_FOYER
conversation
{
    id = 43200;
    class = "CaelumMainM00ConversationMenu";

    page
    {
        pagename = "palomo_foyer";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_DLG_M01_PALOMO_FOYER";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
        ifitem
        {
            item = "CaelumMainM00PalomoMetToken";
            amount = 1;
        }
        link = "palomo_waiting_for_argento";

        choice
        {
            text = "$CA_DLG_M01_PALOMO_ASK_WHERE";
            exclude
            {
                item = "CaelumMainM00AskedPalomoWhereToken";
                amount = 1;
            }
            giveitem = "CaelumMainM00AskPalomoWhereAction";
            nextpage = "palomo_answer_where";
            closedialog = false;
        }
        choice
        {
            text = "$CA_DLG_M01_PALOMO_ASK_WHAT_HAPPENED";
            exclude
            {
                item = "CaelumMainM00AskedPalomoWhatHappenedToken";
                amount = 1;
            }
            giveitem = "CaelumMainM00AskPalomoWhatHappenedAction";
            nextpage = "palomo_answer_what_happened";
            closedialog = false;
        }
        choice
        {
            text = "$CA_DLG_M01_PALOMO_MEMORY_GAP";
            exclude
            {
                item = "CaelumMainM00NoticedMemoryGapToken";
                amount = 1;
            }
            giveitem = "CaelumMainM00TellPalomoMemoryGapAction";
            nextpage = "palomo_answer_memory_gap";
            closedialog = false;
        }
        choice
        {
            text = "$CA_DLG_M01_PALOMO_MENTION_VOICE";
            exclude
            {
                item = "CaelumMainM00ToldPalomoAboutVoiceToken";
                amount = 1;
            }
            giveitem = "CaelumMainM00TellPalomoAboutVoiceAction";
            nextpage = "palomo_answer_voice";
            closedialog = false;
        }
        choice
        {
            text = "$CA_DLG_M01_PALOMO_ASK_GUIDANCE";
            giveitem = "CaelumMainM00FinishPalomoFoyerAction";
            nextpage = "palomo_guides_to_argento";
            closedialog = false;
        }
    }

    page
    {
        pagename = "palomo_answer_where";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_DLG_M01_PALOMO_WHERE_REPLY";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
        choice
        {
            text = "$CA_DLG_M01_BACK";
            nextpage = "palomo_foyer";
            closedialog = false;
        }
    }

    page
    {
        pagename = "palomo_answer_what_happened";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_DLG_M01_PALOMO_WHAT_HAPPENED_REPLY";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
        choice
        {
            text = "$CA_DLG_M01_BACK";
            nextpage = "palomo_foyer";
            closedialog = false;
        }
    }

    page
    {
        pagename = "palomo_answer_memory_gap";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_DLG_M01_PALOMO_MEMORY_GAP_REPLY";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
        choice
        {
            text = "$CA_DLG_M01_BACK";
