            closedialog = false;
        }
    }

    page
    {
        pagename = "palomo_answer_voice";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_DLG_M01_PALOMO_VOICE_REPLY";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
