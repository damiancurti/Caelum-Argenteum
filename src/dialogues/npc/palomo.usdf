        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_INTRO"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        ifitem { item = "CaelumM00AmuletChosenToken"; amount = 1; } link = "palomo_necklace_status";
        choice { text = "$CA_AMULET_RUBY"; nextpage = "palomo_necklace_0"; closedialog = false; }
        choice { text = "$CA_AMULET_SAPPHIRE"; nextpage = "palomo_necklace_1"; closedialog = false; }
        choice { text = "$CA_AMULET_EMERALD"; nextpage = "palomo_necklace_2"; closedialog = false; }
        choice { text = "$CA_AMULET_TOPAZ"; nextpage = "palomo_necklace_3"; closedialog = false; }
        choice { text = "$CA_PALOMO_NECKLACE_BACK"; giveitem = "CaelumM00NecklaceBackAction"; closedialog = true; }
    }
    page { pagename = "palomo_necklace_0"; userstring = "palomo_necklace_0";
        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_CONFIRM"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_AF_CONFIRM"; giveitem = "CaelumM00PalomoAmulet0";
            nextpage = "palomo_necklace_status"; closedialog = false;
            exclude { item = "CaelumM00AmuletChosenToken"; amount = 1; } }
        choice { text = "$CA_AF_BACK"; nextpage = "palomo_necklaces"; closedialog = false; }
    }
    page { pagename = "palomo_necklace_1"; userstring = "palomo_necklace_1";
        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_CONFIRM"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_AF_CONFIRM"; giveitem = "CaelumM00PalomoAmulet1";
            nextpage = "palomo_necklace_status"; closedialog = false;
            exclude { item = "CaelumM00AmuletChosenToken"; amount = 1; } }
        choice { text = "$CA_AF_BACK"; nextpage = "palomo_necklaces"; closedialog = false; }
    }
    page { pagename = "palomo_necklace_2"; userstring = "palomo_necklace_2";
        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_CONFIRM"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_AF_CONFIRM"; giveitem = "CaelumM00PalomoAmulet2";
            nextpage = "palomo_necklace_status"; closedialog = false;
            exclude { item = "CaelumM00AmuletChosenToken"; amount = 1; } }
        choice { text = "$CA_AF_BACK"; nextpage = "palomo_necklaces"; closedialog = false; }
    }
    page { pagename = "palomo_necklace_3"; userstring = "palomo_necklace_3";
        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_CONFIRM"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_AF_CONFIRM"; giveitem = "CaelumM00PalomoAmulet3";
            nextpage = "palomo_necklace_status"; closedialog = false;
            exclude { item = "CaelumM00AmuletChosenToken"; amount = 1; } }
        choice { text = "$CA_AF_BACK"; nextpage = "palomo_necklaces"; closedialog = false; }
    }
    page { pagename = "palomo_necklace_status"; userstring = "palomo_necklace_status";
        name = "$CA_PALOMO_NAME"; dialog = "$CA_PALOMO_NECKLACE_ROOM"; goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_PALOMO_NECKLACE_RETRY"; giveitem = "CaelumM00ReceiveNecklaceAction";
            nextpage = "palomo_necklace_status"; closedialog = false;
            exclude { item = "CaelumM00NecklaceDeliveredToken"; amount = 1; } }
        choice { text = "$CA_PALOMO_NECKLACE_BACK"; giveitem = "CaelumM00NecklaceBackAction"; closedialog = true; }
    }
}

// The existing story remains available during an agreed Fool visit.
conversation
{
    id = 43700;
    class = "CaelumMainM00ConversationMenu";
    page
    {
        pagename = "palomo_fool_return";
        name = "$CA_PALOMO_NAME";
        dialog = "$CA_FOOL_VISIT_HELP";
        goodbye = "$CA_DLG_M01_PALOMO_LEAVE";
        choice { text = "$CA_FOOL_JOURNEY_RETURN"; giveitem = "CaelumFoolReturnAction"; closedialog = true; }
        choice { text = "$CA_FOOL_VISIT_TALK"; giveitem = "CaelumFoolConversationAction"; closedialog = true; }
    }
}
