// #421: conservar reconocimiento previo y ampliar defensa/desenlace.
conversation
{
    id = 43654;
    class = "CaelumPortStoryMenu";
    page
    {
        pagename = "story_guard_captain_first";
        userstring = "guard_captain_first";
        name = "$CA_PORT_SOLDIER";
        dialog = "$CA_GUARD_CAPTAIN_FIRST";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice
        {
            text = "$CA_PORT_STORY_CHOICE";
            nextpage = "story_guard_first_account";
            giveitem = "CaelumPortStoryAction";
            closedialog = false;
        }

        choice
        {
            text = "$CA_GUARD_CAPTAIN_FIRST_RESPONSE";
            nextpage = "story_guard_captain_first_answer";
            closedialog = false;
        }
    }
    page
    {
        pagename = "story_guard_captain_first_answer";
        userstring = "guard_captain_first_answer";
        name = "$CA_PORT_SOLDIER";
        dialog = "$CA_GUARD_CAPTAIN_ANSWER";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice
        {
            text = "$CA_PORT_STORY_CHOICE";
            nextpage = "story_guard_first_account";
            giveitem = "CaelumPortStoryAction";
            closedialog = false;
        }

    }

    page
    {
        pagename = "story_guard_first_account";
        userstring = "port_story_account";
        name = "$CA_PORT_SOLDIER";
        dialog = "$CA_PORT_STORY_GUARD";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice
        {
            text = "$CA_PORT_SOCIAL_BACK";
            nextpage = "story_guard_captain_first";
            closedialog = false;
        }
    }
}

