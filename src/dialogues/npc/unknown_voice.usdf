namespace = "GZDoom";

// CA_DLG_M01_UNKNOWN_VOICE_WAKE
conversation
{
    id = 43300;
    class = "CaelumPalomoConversationMenu";

    page
    {
        pagename = "unknown_voice_wake";
        name = "$CA_SPEAKER_UNKNOWN_VOICE";
        dialog = "$CA_DLG_M01_UNKNOWN_VOICE_WAKE";
        goodbye = "$CA_DLG_M01_UNKNOWN_VOICE_SILENCE";

        choice
        {
            text = "$CA_DLG_M01_UNKNOWN_VOICE_ASK_WHO";
            nextpage = "unknown_voice_who";
            closedialog = false;
        }
        choice
        {
            text = "$CA_DLG_M01_UNKNOWN_VOICE_ASK_WHERE";
            nextpage = "unknown_voice_where";
            closedialog = false;
        }
    }

    page
    {
        pagename = "unknown_voice_who";
        name = "$CA_SPEAKER_UNKNOWN_VOICE";
        dialog = "$CA_DLG_M01_UNKNOWN_VOICE_WHO_REPLY";
        goodbye = "$CA_DLG_M01_CONTINUE";
    }

    page
    {
        pagename = "unknown_voice_where";
        name = "$CA_SPEAKER_UNKNOWN_VOICE";
        dialog = "$CA_DLG_M01_UNKNOWN_VOICE_WHERE_REPLY";
        goodbye = "$CA_DLG_M01_CONTINUE";
    }
}

conversation
{
    id = 43321;
    class = "CaelumReturnConversationMenu";
    page
    {
        pagename = "sewer_voice"; userstring = "sewer_voice";
        name = "$CA_SPEAKER_UNKNOWN_VOICE"; dialog = "$CA_M01_RETURN_VOICE";
        goodbye = "$CA_M01_RETURN_CONTINUE";
        choice { text = "$CA_M01_RETURN_LOOK"; nextpage = "sewer_arrival"; closedialog = false; }
    }
    page
    {
        pagename = "sewer_arrival"; userstring = "sewer_arrival";
        name = "$CA_MAP02_SEWER_NAME"; dialog = "$CA_M01_RETURN_COMPLETE";
        goodbye = "$CA_M01_RETURN_CONTINUE";
    }
}

