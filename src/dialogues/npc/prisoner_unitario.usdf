namespace = "GZDoom";

// CA_PRISONER_RESCUE_CELL — captives converse in their MAP02 cells.
conversation
{
    id = 43420;
    class = "CaelumPalomoConversationMenu";

    page
    {
        pagename = "prisoner_unitario_cell";
        name = "$CA_PRISONER_UNITARIO_NAME";
        dialog = "$CA_PRISONER_DLG_UNITARIO_CELL";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        ifitem { item = "CaelumPrisonerFreed0Token"; amount = 1; } link = "prisoner_unitario_follow";
        choice
        {
            text = "$CA_PRISONER_RELEASE_CHOICE";
            giveitem = "CaelumPrisonerReleaseAction";
            nextpage = "prisoner_unitario_follow";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_unitario_follow";
        name = "$CA_PRISONER_UNITARIO_NAME";
        dialog = "$CA_PRISONER_DLG_UNITARIO_FOLLOW";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
    }
}

// CA_PRISONER_RESCUE_PORT — each rescued prisoner appears once in MAP06.
conversation
{
    id = 43424;
    class = "CaelumPalomoConversationMenu";

    page
    {
        pagename = "prisoner_unitario_port";
        name = "$CA_PRISONER_UNITARIO_NAME";
        dialog = "$CA_PRISONER_DLG_UNITARIO_PORT";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        ifitem { item = "CaelumPrisonerClaimed0Token"; amount = 1; } link = "prisoner_unitario_claimed";
        choice
        {
            text = "$CA_PRISONER_PORT_CLAIM_CHOICE";
            giveitem = "CaelumPrisonerClaimAction";
            nextpage = "prisoner_unitario_outcome";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_unitario_outcome";
        name = "$CA_PRISONER_UNITARIO_NAME";
        dialog = "$CA_PRISONER_PORT_REWARD_FAIL";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        ifitem { item = "CaelumPrisonerClaimed0Token"; amount = 1; } link = "prisoner_unitario_claimed";
    }

    page
    {
        pagename = "prisoner_unitario_claimed";
        userstring = "prisoner_unitario_claimed";
        name = "$CA_PRISONER_UNITARIO_NAME";
        dialog = "$CA_PRISONER_PORT_REWARD_GRANTED";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
    }
}
