            giveitem = "CaelumPortEmotionAction";
        }
        choice
        {
            text = "$CA_PORT_FACTION_CHOICE";
            nextpage = "prisoner_tarot_affiliations";
            closedialog = false;
            require { item = "CaelumPortRepresentativeToken"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_SOCIAL_BACK";
            nextpage = "prisoner_tarot_port";
