        }
        choice
        {
            text = "$CA_PORT_SOCIAL_BACK";
            nextpage = "prisoner_tarot_social";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_tarot_declared";
        name = "$CA_PRISONER_TAROT_NAME";
