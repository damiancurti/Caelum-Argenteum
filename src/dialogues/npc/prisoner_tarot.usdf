        choice
        {
            text = "$CA_PRISONER_PORT_CLAIM_CHOICE";
            giveitem = "CaelumPrisonerClaimAction";
            nextpage = "prisoner_tarot_outcome";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_tarot_outcome";
        name = "$CA_PRISONER_TAROT_NAME";
        dialog = "$CA_PRISONER_PORT_REWARD_FAIL";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        ifitem { item = "CaelumPrisonerClaimed3Token"; amount = 1; } link = "prisoner_tarot_claimed";
    }

    page
    {
        pagename = "prisoner_tarot_claimed";
        userstring = "prisoner_tarot_claimed";
        name = "$CA_PRISONER_TAROT_NAME";
        dialog = "$CA_PRISONER_PORT_REWARD_GRANTED";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
    }
}

// #419: appended native conversation; preserve every earlier saved node index.
conversation
{
    id = 43643;
    class = "CaelumPortConversationMenu";

    page
    {
        pagename = "prisoner_tarot_port";
