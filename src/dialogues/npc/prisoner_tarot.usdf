        {
            text = "$CA_PORT_SOCIAL_BACK";
            nextpage = "prisoner_tarot_social";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_tarot_affiliations";
        name = "$CA_PRISONER_TAROT_NAME";
        dialog = "$CA_PORT_DECLARATION_INTRO";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice
        {
            text = "$CA_PORT_DECLARE_0";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare0Action";
            require { item = "CaelumPortMember0Token"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_DECLARE_1";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare1Action";
            require { item = "CaelumPortMember1Token"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_DECLARE_2";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare2Action";
            require { item = "CaelumPortMember2Token"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_DECLARE_3";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare3Action";
            require { item = "CaelumPortMember3Token"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_DECLARE_4";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare4Action";
            require { item = "CaelumPortMember4Token"; amount = 1; }
        }
        choice
        {
            text = "$CA_PORT_DECLARE_5";
            nextpage = "prisoner_tarot_declared";
            closedialog = false;
            giveitem = "CaelumPortDeclare5Action";
            require { item = "CaelumPortMember5Token"; amount = 1; }
