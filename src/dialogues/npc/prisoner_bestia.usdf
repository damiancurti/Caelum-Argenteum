namespace = "GZDoom";

conversation
{
    id = 43422;
    class = "CaelumPalomoConversationMenu";

    page
    {
        pagename = "prisoner_bestia_cell";
        name = "$CA_PRISONER_BESTIA_NAME";
        dialog = "$CA_PRISONER_DLG_BESTIA_CELL";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_COMPANION_DIALOGUE"; giveitem = "CaelumCompanionOpenAction"; closedialog = true; }

        ifitem { item = "CaelumPrisonerFreed2Token"; amount = 1; } link = "prisoner_bestia_follow";
        choice
        {
            text = "$CA_PRISONER_RELEASE_CHOICE";
            giveitem = "CaelumPrisonerReleaseAction";
            nextpage = "prisoner_bestia_follow";
            closedialog = false;
        }
    }

    page
    {
        pagename = "prisoner_bestia_follow";
        name = "$CA_PRISONER_BESTIA_NAME";
        dialog = "$CA_PRISONER_DLG_BESTIA_FOLLOW";
        goodbye = "$CA_DLG_M01_SOCIAL_LEAVE";
        choice { text = "$CA_COMPANION_DIALOGUE"; giveitem = "CaelumCompanionOpenAction"; closedialog = true; }

    }
}

conversation
