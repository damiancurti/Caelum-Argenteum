namespace = "GZDoom";

// 4.35.0d: descanso/espera opcionales; las ayudas nunca se conceden al abrir.
conversation
{
    id = 43510;
    class = "CaelumPalomoConversationMenu";
    page
    {
        pagename = "rest_offer";
        name = "$CA_REST_TITLE"; dialog = "$CA_REST_OFFER";
        goodbye = "$CA_REST_CLOSE";
        choice { text = "$CA_REST_SLEEP"; nextpage = "rest_sleep"; closedialog = false; }
        choice { text = "$CA_REST_WAIT"; nextpage = "rest_wait"; closedialog = false; }
        choice { text = "$CA_REST_PREPARE_MENU"; nextpage = "rest_prepare"; closedialog = false; }
    }
    page
    {
        pagename = "rest_sleep";
        name = "$CA_REST_TITLE"; dialog = "$CA_REST_SLEEP_INFO";
        goodbye = "$CA_REST_CLOSE";
        choice { text = "$CA_REST_DURATION_5"; giveitem = "CaelumRestSleep5Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_60"; giveitem = "CaelumRestSleep60Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_240"; giveitem = "CaelumRestSleep240Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_480"; giveitem = "CaelumRestSleep480Action"; closedialog = true; }
        choice { text = "$CA_REST_BACK"; nextpage = "rest_offer"; closedialog = false; }
    }
    page
    {
        pagename = "rest_wait";
        name = "$CA_REST_TITLE"; dialog = "$CA_REST_WAIT_INFO";
        goodbye = "$CA_REST_CLOSE";
        choice { text = "$CA_REST_DURATION_5"; giveitem = "CaelumRestWait5Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_60"; giveitem = "CaelumRestWait60Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_240"; giveitem = "CaelumRestWait240Action"; closedialog = true; }
        choice { text = "$CA_REST_DURATION_480"; giveitem = "CaelumRestWait480Action"; closedialog = true; }
        choice { text = "$CA_REST_BACK"; nextpage = "rest_offer"; closedialog = false; }
    }
    page
    {
        pagename = "rest_prepare";
        name = "$CA_REST_TITLE"; dialog = "$CA_REST_PREPARE_INFO";
        goodbye = "$CA_REST_CLOSE";
        choice { text = "$CA_REST_PREPARE_NORMAL"; giveitem = "CaelumRestPrepareAction"; closedialog = true; }
        choice { text = "$CA_REST_PREPARE_LOW"; giveitem = "CaelumRestPrepareLowAction"; closedialog = true; }
        choice { text = "$CA_SLEEPING_BAG_PREPARE"; giveitem = "CaelumRestPrepareBagAction"; closedialog = true; }
        choice { text = "$CA_REST_BACK"; nextpage = "rest_offer"; closedialog = false; }
    }
}

