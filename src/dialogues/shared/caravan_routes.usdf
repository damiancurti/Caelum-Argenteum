namespace = "GZDoom";

// 4.34.0d: servicio de caravana opcional entre alcantarillas de prueba.
conversation
{
    id = 43410;
    class = "CaelumPalomoConversationMenu";
    page
    {
        pagename = "caravan_routes";
        name = "$CA_CARAVAN_TITLE"; dialog = "$CA_CARAVAN_OFFER";
        goodbye = "$CA_CARAVAN_CANCEL";
        choice { text = "$CA_MAP06_NAME"; nextpage = "caravan_16"; closedialog = false; }
        choice { text = "$CA_SEWER_SUPPORT_SEAL"; giveitem = "CaelumSewerPrepareSealAction"; closedialog = true; }
        choice { text = "$CA_SEWER_SUPPORT_CRAFT"; giveitem = "CaelumSewerPrepareCraftAction"; closedialog = true; }
    }
    page
    {
        pagename = "caravan_2";
        name = "$CA_CARAVAN_TITLE"; dialog = "$CA_CARAVAN_CONFIRM_2";
        goodbye = "$CA_CARAVAN_CANCEL";
        choice { text = "$CA_CARAVAN_DEPART"; giveitem = "CaelumCaravanRoute2Action"; closedialog = true; }
        choice { text = "$CA_CARAVAN_BACK"; nextpage = "caravan_routes"; closedialog = false; }
    }
    page
    {
        pagename = "caravan_4";
        name = "$CA_CARAVAN_TITLE"; dialog = "$CA_CARAVAN_CONFIRM_4";
        goodbye = "$CA_CARAVAN_CANCEL";
        choice { text = "$CA_CARAVAN_DEPART"; giveitem = "CaelumCaravanRoute4Action"; closedialog = true; }
        choice { text = "$CA_CARAVAN_BACK"; nextpage = "caravan_routes"; closedialog = false; }
    }
    page
    {
        pagename = "caravan_6";
        name = "$CA_CARAVAN_TITLE"; dialog = "$CA_CARAVAN_CONFIRM_6";
        goodbye = "$CA_CARAVAN_CANCEL";
        choice { text = "$CA_CARAVAN_DEPART"; giveitem = "CaelumCaravanRoute6Action"; closedialog = true; }
        choice { text = "$CA_CARAVAN_BACK"; nextpage = "caravan_routes"; closedialog = false; }
    }
    page
    {
        pagename = "caravan_16";
        name = "$CA_CARAVAN_TITLE"; dialog = "$CA_CARAVAN_CONFIRM_16";
        goodbye = "$CA_CARAVAN_CANCEL";
        choice { text = "$CA_CARAVAN_DEPART"; giveitem = "CaelumCaravanRoute16Action"; closedialog = true; }
        choice { text = "$CA_CARAVAN_BACK"; nextpage = "caravan_routes"; closedialog = false; }
    }
}

