// Generated by generate_transport_scenes.py; geometry only, no travel balance.
class CaelumTransportSceneData : Object
{
    const REVISION=1;
    const RURAL_INTERVAL_KM=10;
    const RURAL_COUNT=41;
    static clearscope String Stage(int route,int mode){return String.Format("CAT%d%02d",mode,route);}
    static clearscope String Rural(int index){return String.Format("CAR%02d",Clamp(index,0,RURAL_COUNT-1));}
    static clearscope bool IsStage(String map){return map.Left(3)=="CAT" && map.Length()==6;}
    static clearscope bool IsRural(String map){return map.Left(3)=="CAR" && map.Length()==5;}
    static clearscope vector3 RuralEntry(){return (0,256,0);}
    static clearscope vector3 AccessPosition(){return (0,48,0);}
    static clearscope bool BlocksRuralAccess(vector3 point,double radius)
    {return point.X+radius>-96 && point.X-radius<96
        && point.Y+radius>128 && point.Y-radius<384;}
    static clearscope String GroundFlat(){return "CMGR02";}
    static clearscope int TreeCount(){return 4;}
    static clearscope vector3 Tree(int index)
    {vector3 positions[]={(-768,-640,0),(-640,704,0),(704,-704,0),(768,640,0)};return positions[Clamp(index,0,3)];}
}
