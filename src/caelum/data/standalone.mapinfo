// Datos compartidos con las arenas; cambia solamente el hub.
gameinfo { PlayerClasses = "CaelumStandalonePlayer" }
map CARING "$CA_ARENA_RING" { cluster=0 nointermission teamdamage=1 UnFreezeSinglePlayerConversations music="CA_MUS04_PORT" }
map CASEWER "$CA_ARENA_MAZE" { cluster=0 nointermission teamdamage=1 UnFreezeSinglePlayerConversations music="CA_MUS03_SEWER" }
