// #479: selectores nuevos; se conservan las clases y estados antiguos para las partidas.
class CaelumSupportBookT1Weapon : CaelumMagicSelectorWeapon
{
    Default { Weapon.SelectionOrder 703; Weapon.SlotNumber 0; }
    override int GetCaelumWeaponType() { return CaelumConstants.WEAPON_TYPE_SUPPORT_BOOK+0; }
    override int GetCaelumEssenceType() { return CaelumConstants.ESSENCE_QUINTESSENCE; }
    override int GetCaelumTier() { return 1; }
}
