// Gemas decorativas: Actor puro, sin recursos, inventario ni extracción.
class CaelumCaveSceneryRuby : CaelumPhysicalScenery
{
    Default { +NOGRAVITY }
    States { Spawn: CAVE J -1; Stop; }
}
