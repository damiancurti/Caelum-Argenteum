// GameInfo modifica ajustes globales suministrados por el proyecto.
GameInfo
{
    // Reemplaza la clase de jugador por la clase ZScript propia del proyecto.
    PlayerClasses = "CaelumPlayer"

    // Pantalla de presentación oficial suministrada por el autor.
    TitlePage = "TITLEPIC"
    TitleMusic = "CA_MUS01"
    // Evita que el ciclo del título vuelva a mostrar los créditos de Doom II.
    CreditPage = "TITLEPIC"

    // Elimina el status bar, rostro y contadores heredados de Doom. La capa
    // permanente se compone con los recursos propios HUD-01.
    StatusBarClass = "CaelumStatusBar"

    // Los EventHandlers observan eventos del motor sin convertirse en actores del mapa.
    EventHandlers = "CaelumMassAIScheduler", "CaelumHUDOverlay", "CaelumJournalOverlay", "CaelumDebugOverlay"

    // USDF nativo cargado de forma aditiva en todos los mapas. Esto permite
    // trasladar o recrear a Palomo durante futuras etapas de misión sin
    // duplicar el árbol de conversación en cada DIALOGxx.
    AddDialogues = "CAPALOMO"
}

// Caelum administra su progresión dentro del personaje. Las cinco dificultades
// heredadas de Doom alterarían daño, munición, población y velocidad de los
// enemigos sin respetar esas reglas, por lo que se sustituyen por un único modo
// neutral. Al existir una sola opción GZDoom omite la pantalla de dificultad.
clearskills
skill Caelum
{
    Name = "$CA_SKILL_CAELUM"
    Key = "c"
    DefaultSkill
    SpawnFilter = Normal
}

// Los mapas permanecen separados durante la consolidación: MAP01 valida
// arquitectura y MAP02 valida actores, IA, colisiones y efectos de área.
map MAP01 "Mansión — prueba arquitectónica"
{
    music = "CA_MUS01"

    // Transición provisional directa: las estadísticas Doom no se muestran.
    nointermission

    // El Exit existente conduce al campo independiente de actores.
    next = "MAP02"
}

map MAP02 "Campo de pruebas de actores"
{
    music = "CA_MUS02"
}

