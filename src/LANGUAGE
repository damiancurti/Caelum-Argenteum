[default]
CA_DLG_M01_SOCIAL_LEAVE = "[I will return later.]";
CA_DLG_M01_RULO_EMOTION = "Worried";
CA_DLG_M01_ARGENTO_EARLY = "You seem to be looking for an answer too. Speak with Palomo first; he usually leaves a useful question among his evasions.";
CA_DLG_M01_ARGENTO_ASK_HELP = "I need help finding a way out.";
CA_DLG_M01_ARGENTO_START = "You also woke without remembering the way here. That gives us a question in common, but not an answer yet.";
CA_DLG_M01_ARGENTO_ASK_HOW = "How do I get them to listen?";
CA_DLG_M01_ARGENTO_RESIDENTS = "Rulo knows what you may have to face. Ronnie knows what a journey needs. Caella senses what this house tries to hide. None of them has a reason to help just because you ask.";
CA_DLG_M01_ARGENTO_ACCEPT = "I will speak with all three.";
CA_DLG_M01_ARGENTO_QUOTE = "Palomo once told me: “Convincing someone is not finding words that force them. It is discovering what they are trying to protect.” He never explained what he expected us to do with that.";
CA_DLG_M01_ARGENTO_ADVICE_RULO = "I could not read Rulo.";
CA_DLG_M01_ARGENTO_ADVICE_RONNIE = "Ronnie says we need a plan.";
CA_DLG_M01_ARGENTO_ADVICE_CAELLA = "Caella does not trust this anomaly.";
CA_DLG_M01_ARGENTO_PROGRESS = "You have the help of %COUNT% of the three. Listen to what worries each of them. If a conversation went poorly, we can find another way to approach it.";
CA_DLG_M01_ARGENTO_HINT_RULO = "You do not need to guess every thought. Tell him what help you need and make it clear he can warn you of a risk or refuse. His judgment matters as much as his strength.";
CA_DLG_M01_ARGENTO_HINT_RONNIE = "Put the journey in order: gather information, open a path, obtain supplies, and prepare before fighting. Ronnie needs to know you are not asking him to go forward blindly.";
CA_DLG_M01_ARGENTO_HINT_CAELLA = "Do not promise there is no danger. Acknowledge what she senses and let her set the conditions for examining it. Asking for help also means accepting her limits.";
CA_DLG_M01_ARGENTO_FINISH = "All three agreed to help.";
CA_DLG_M01_ARGENTO_ALL_READY = "You have heard all three. Did you find a reason for each to help?";
CA_DLG_M01_ARGENTO_NEXT = "Who should I speak with next?";
CA_DLG_M01_ARGENTO_COMPLETE = "You did not convince them of the same thing. You gave each a different reason to go forward. Perhaps that is what Palomo meant.";
CA_DLG_M01_ARGENTO_NEXT_REPLY = "%CURRENT_GOAL%";
CA_DLG_M01_RULO_EARLY = "If you need a place to start, speak with Argento. I am still deciding what is worth getting involved in.";
CA_DLG_M01_RULO_READ = "Try to understand his reaction. [Emotion: 120]";
CA_DLG_M01_RULO_REVISIT = "Reconsider the request.";
CA_DLG_M01_RULO_RECRUIT = "Another task because someone said it had to be done? I have done enough of those. Before I promise anything, I want to know why you need my help.";
CA_DLG_M01_RULO_ROLL = "Pay attention to what he is trying to hide.";
CA_DLG_M01_RULO_CHECK = "Rulo avoids looking toward the other rooms. You may try to read his reaction. Reading chance: %RULO_CHANCE%%. Difficulty: 120.";
CA_DLG_M01_RULO_ADVISED_ANSWER = "I need your judgment. You can warn me of danger or refuse.";
CA_DLG_M01_RULO_READ_FAILURE = "You could not read his reaction. Rulo is still waiting for a reason. Speaking with Argento may help you frame the request differently.";
CA_DLG_M01_RULO_RESPECT = "I need your help and judgment, not a weapon.";
CA_DLG_M01_RULO_READ_SUCCESS = "He does not seem bored. He worries about endangering the others and being wanted only for the strength to do it. You understand his reluctance better now.";
CA_DLG_M01_RULO_STILL_WAITING = "You have not told me what you expect of me yet.";
CA_DLG_M01_RULO_ACCEPTED = "Then yes. If I see a risk, I will tell you. When the time comes to face it, you can count on me.";
CA_DLG_M01_RONNIE_EARLY = "A journey begins before the first step. Speak with Argento; then we can work out what is needed.";
CA_DLG_M01_RONNIE_PLAN = "Information, a path, supplies and preparation. [Eloquence skill: 1]";
CA_DLG_M01_RONNIE_ADVICE_PLAN = "Argento helped me put the steps in order. Here is the plan...";
CA_DLG_M01_RONNIE_ASK_PLAN = "What do you need to know before helping?";
CA_DLG_M01_RONNIE_RECRUIT = "You want to leave, but I see neither a plan nor supplies. Walking until something finds us is not a journey. Your Eloquence skill: %LABIA%.";
CA_DLG_M01_RONNIE_PLAN_HINT = "What we will learn, where we will go and what supplies we will use. If you cannot put that in order yet, discuss it with Argento and return with something concrete.";
CA_DLG_M01_RONNIE_REQUIREMENT = "That plan still needs a clear order. You can speak with Argento and return with new information.";
CA_DLG_M01_RONNIE_ACCEPTED = "That has an order. First information and a path; then supplies and preparation. I will help you. We will deal with provisions once we know which way to go.";
CA_DLG_M01_CAELLA_EARLY = "There is something strange around you. Stranger than the rest of this house, I mean. Speak with Argento before we try to explain it.";
CA_DLG_M01_CAELLA_ASK_ATTEMPT = "Ask her to examine it and help find a passage. [Persuasion: 120]";
CA_DLG_M01_CAELLA_REVISIT_FAILURE = "Discuss her refusal.";
CA_DLG_M01_CAELLA_SAFETY = "There is danger. You set the conditions for examining it.";
CA_DLG_M01_CAELLA_RECRUIT = "The anomaly around you could be dangerous. I do not know what it is, and I would rather not find out by accident. Why should I come closer?";
CA_DLG_M01_CAELLA_ROLL = "If we examine it together, we have a chance to understand it.";
CA_DLG_M01_CAELLA_CHECK = "Caella waits for your explanation. You may try to persuade her. Chance: %CAELLA_CHANCE%%. Difficulty: 120.";
CA_DLG_M01_CAELLA_SAFETY_RETRY = "I acknowledge the danger. You set the conditions.";
CA_DLG_M01_CAELLA_FAILURE = "That promise is not enough. We still do not know what we would be exposing ourselves to. Speak with Argento; perhaps he can help you ask without denying the risk.";
CA_DLG_M01_CAELLA_STILL_WAITING = "I need you to understand the risk before we continue.";
CA_DLG_M01_CAELLA_ACCEPTED = "All right. I will help you examine it, carefully. Tell Argento he can count on me.";
CA_DLG_M01_CAELLA_NEXT_READY = "There is a wall that sounds hollow when nobody touches it and solid when I try to open it. This house has a terrible sense of humor. It must get along with Palomo.";
CA_Q_M01_STATE_RECRUIT_RESIDENTS = "Gain the residents' help";
CA_Q_M01_STATE_RETURN_ARGENTO = "Return to Argento";
CA_Q_M01_STATE_TALK_CAELLA = "Speak with Caella";

[es]
CA_DLG_M01_SOCIAL_LEAVE = "[Volveré luego.]";
CA_DLG_M01_RULO_EMOTION = "Preocupado";
CA_DLG_M01_ARGENTO_EARLY = "También parecés estar buscando una respuesta. Hablá primero con Palomo; suele dejar alguna pregunta útil entre sus evasivas.";
CA_DLG_M01_ARGENTO_ASK_HELP = "Necesito ayuda para salir de acá.";
CA_DLG_M01_ARGENTO_START = "También despertaste sin recordar el camino. Eso nos da una pregunta en común, pero todavía no una respuesta.";
