CA_M01_WEAPON_DESC_0 = "Daga: Poco alcance y bajo gasto de Aire. El ataque principal apuñala; el secundario corta. Compatible con escudo.";
CA_M01_WEAPON_DESC_1 = "Hachuela: El principal corta y el secundario golpea de forma contundente. Alcance corto; compatible con escudo.";
CA_M01_WEAPON_DESC_2 = "Machete: El principal corta; la estocada secundaria llega más lejos. Compatible con escudo.";
CA_M01_WEAPON_DESC_3 = "Jabalina: El principal apuñala. El secundario arroja, o apuñala si el objetivo está muy cerca. Arrojar gasta Aire y durabilidad.";
CA_M01_WEAPON_DESC_4 = "Espada: El principal corta y el secundario da una estocada más larga. Sirve para árboles, arbustos y vetas. Compatible con escudo.";
CA_M01_WEAPON_DESC_5 = "Hacha: El principal corta; el secundario es un golpe contundente más corto. Gasta más Aire que la espada. Compatible con escudo.";
CA_M01_WEAPON_DESC_6 = "Mangual: Ambos ataques son contundentes; el secundario es más fuerte. Compatible con escudo. No sirve para cortar plantas.";
CA_M01_WEAPON_DESC_7 = "Lanza: Un ataque perforante largo que puede usarse mientras bloqueas. No tiene ataque secundario.";
CA_M01_WEAPON_DESC_8 = "Mandoble: Más alcance y fuerza que la espada, con más gasto de Aire y golpes más lentos. No permite bloquear con escudo. Zoom: barrido de 360 grados, mismo alcance y daño del primario, triple Aire.";
CA_M01_WEAPON_DESC_9 = "Hacha de guerra: Cortes fuertes y lentos, con un secundario contundente. Alto gasto de Aire. No permite bloquear con escudo. Zoom: barrido de 360 grados, mismo alcance y daño del primario, triple Aire.";
CA_M01_WEAPON_DESC_10 = "Alabarda: Combina daño cortante y perforante con mucho alcance. Arma grande; no permite bloquear con escudo. Zoom: barrido de 360 grados, mismo alcance y daño del primario, triple Aire.";
CA_M01_WEAPON_DESC_11 = "Guanteletes gigantes: Ataques contundentes pesados. El secundario agrega empuje hacia arriba. Los guanteletes tienen su propio modo de bloqueo.";
CA_M01_WEAPON_DESC_12 = "Arco: usa flechas. Apuntá con Zoom o el ataque secundario; recargá con Recargar. También te enseñaré a fabricar lotes de diez flechas y sus componentes.";
CA_M01_WEAPON_DESC_13 = "Carabina: Disparos potentes, con alto gasto de Aire y menor cadencia. Permite apuntar y recargar; necesita cartuchos.";
CA_M01_WEAPON_DESC_14 = "Arco largo: mayor alcance y precisión que el arco, con mayor gasto de Aire. También te enseñaré a fabricar lotes de diez flechas y sus componentes.";
CA_M01_WEAPON_DESC_15 = "Ballesta: usa virotes; apuntá con Zoom o el secundario y recargá con Recargar. Es más lenta que el arco. También te enseñaré a fabricar lotes de diez virotes y sus componentes.";
