CA_DLG_M01_ARGENTO_ADVICE_RONNIE = "Ronnie dice que falta un plan.";
CA_DLG_M01_ARGENTO_ADVICE_CAELLA = "Caella no confía en esta anomalía.";
CA_DLG_M01_ARGENTO_PROGRESS = "Ya contás con la ayuda de %COUNT% de los tres. Escuchá lo que le preocupa a cada uno. Si una conversación salió mal, podemos buscar otra forma de plantearla.";
CA_DLG_M01_ARGENTO_HINT_RULO = "No hace falta adivinarle todos los pensamientos. Decile qué ayuda necesitás y dejá claro que podrá advertirte de un riesgo o negarse. Su criterio también cuenta, no sólo su fuerza.";
