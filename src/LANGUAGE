CA_DLG_M01_ARGENTO_FINISH = "Los tres aceptaron ayudarme.";
CA_DLG_M01_ARGENTO_ALL_READY = "Ya escuchaste a los tres. ¿Encontraste una razón para que cada uno colabore?";
CA_DLG_M01_ARGENTO_NEXT = "¿Con quién sigo?";
CA_DLG_M01_ARGENTO_COMPLETE = "No los convenciste de lo mismo. A cada uno le diste una razón distinta para avanzar. Tal vez eso era lo que Palomo intentaba decir.";
CA_DLG_M01_ARGENTO_NEXT_REPLY = "%CURRENT_GOAL%";
