CA_M01_KEY_WAIT = "El Toro está en la habitación cerrada detrás del lugar donde despertaste. Yo guardo la llave de plata. Terminá de prepararte con Caella y Ronnie y completá las prácticas con Rulo antes de pedírmela.";
CA_M01_KEY_READY = "Ya te preparaste con los cuatro. Llevate la llave de plata. Rulo, Ronnie, Caella y yo nos reuniremos con vos en la sala del Toro, detrás del lugar donde despertaste. Vamos a pelear juntos.";
CA_M01_KEY_TAKE = "Recibir la llave de plata.";
CA_M01_KEY_GIVEN = "Tenés la llave de plata. Abrí la habitación detrás del lugar donde despertaste. Los cuatro estaremos con vos al comenzar el combate; cuando ganemos, hablá con Rulo ahí mismo.";

// 4.33.0p: entrenamiento y combate de Rulo.

[enu default]
CA_M01_RULO_OFFER = "The weapon is ready. That does not mean you are.\n\nI have beaten the Bull. Afterwards, Palomo said: “One can lose much after having won.” If you understand what he meant, save the explanation until we get out.\n\nFirst we practice. Then Argento will give you the silver key.";
CA_M01_RULO_START = "I am ready to train.";
CA_M01_RULO_PREPARE = "Prepare my weapon and replenish practice ammunition.";
CA_M01_RULO_CONTROLS = "Review the exercises.";
CA_M01_RULO_EQUIVALENTS = "What if my weapon works differently?";
CA_M01_RULO_PRACTICE = "The target is one floor below my room: the first north room on the ground floor. Hit it, try your weapon actions and learn to recover Air. The journal, under Quests > Detail (F), tracks every exercise.\n\n%DEFENSE%";
CA_M01_RULO_LESSON = "At the target: primary attack (Fire), secondary attack (AltFire), and a charged hit: prepare the charge with Reload, then attack. %DEFENSE% Spend Air and let it recover. Check the six marks in Detail (F).";
CA_M01_RULO_EQUIVALENT_TEXT = "%DEFENSE%\n\nRanged: hit the target, aim with AltFire/Zoom, then reload with Reload; aiming covers secondary and defense. Spear without a secondary: hit while moving forward. Magic: hit with both attacks and a charged one, or cast while moving sideways; running spends Air. Borrowed ammunition: 24 projectiles, replenished if exhausted during the Bull fight. Unused rounds are returned at turn-in.";
CA_M01_RULO_KEY = "Ask Argento for the silver key in his southeast room on the first floor. Open the locked room behind the place where you awoke. All four of us will fight beside you. A fallen companion stays down until the attempt ends; if you fall, the whole group recovers and the trial restarts. Speak with me there after victory.";
CA_M01_RULO_VICTORY = "You brought us together, and together we brought it down. That strength of yours was there before I taught you anything. But today you also got four stubborn people to follow you. That is leadership.\n\nPerhaps that was what Palomo meant: winning is worth little if you lose everyone beside you.";
CA_M01_RULO_FINISH = "Finish the trial.";
CA_M01_RULO_DONE = "You have the strength, and you know how to bring people together. Take care of those who follow you. Palomo went to the second floor; look for him there when you are ready.";
CA_M01_RULO_PRACTICE_READY = "Exercises complete: ask Argento for the silver key.";
CA_M01_RULO_PRACTICE_DONE = "Exercise recorded. Check Quests > Detail (F).";
CA_M01_RULO_AMMO_RESERVED = "Borrowed ammunition is used in the trial and returned to Rulo.";
CA_M01_RULO_AMMO_WEIGHT = "Free some carrying capacity to receive practice ammunition.";
CA_M01_RULO_RETRY = "The group recovers and returns to formation. Get ready: the Bull will try again.";
CA_M01_RULO_FIGHT_BEGIN = "Rulo, Ronnie, Argento and Caella join you. The room closes: face the Bull together.";
CA_M01_RULO_BULL_WON = "Bull defeated. Speak with Rulo again. Any leather within your remaining allowance can be collected.";
CA_M01_RULO_DETAIL_OFFER = "Speak with Rulo in the first north room on the first floor (upstairs, left as you enter). Your first weapon is ready and Ronnie has his sword back.";
CA_M01_RULO_DETAIL_PRACTICE = "Train with the target in the first north room on the ground floor, directly below Rulo. Complete the six exercises. Rulo can prepare your weapon and ammunition again.";
CA_M01_RULO_DETAIL_KEY = "All six exercises are complete. Ask Argento for the silver key in his southeast room on the first floor. Choose the key option.";
CA_M01_RULO_DETAIL_DOOR = "Open the locked door behind the place where you awoke and enter. Rulo, Ronnie, Argento and Caella join you inside before the Bull attacks.";
CA_M01_RULO_DETAIL_FIGHT = "Fight alongside all four residents. The Bull can attack any of you. Evade its wind-up and manage Air and Anima. Fallen companions stay down until the attempt ends. If you fall, the whole group and the Bull recover; your exercises remain completed.";
CA_M01_RULO_DETAIL_RETURN = "You defeated the Bull together. The room is open and all four companions recover. It leaves 12.5 kg of usable cow leather. Speak with Rulo beside you: the trial has shown your innate strength and your ability to lead the group.";
CA_M01_RULO_DETAIL_DONE = "Rulo recognized your innate strength and your ability to bring the four residents together and lead them. Your next meeting is with Palomo in the second-floor room containing all the stations.";
CA_M01_RULO_CHECK_PRIMARY = "Hit the target with Fire.";
CA_M01_RULO_CHECK_SECONDARY = "Secondary: AltFire; ranged, aim; spear, a hit while advancing.";
CA_M01_RULO_CHECK_DEFENSE = "Block (Zoom), aim, or move sideways to evade.";
CA_M01_RULO_CHECK_BLOCK = "Defense: block with Zoom in the target room.";
CA_M01_RULO_CHECK_AIM = "Defense: aim with AltFire or Zoom in the target room.";
CA_M01_RULO_CHECK_EVADE = "Defense: take sideways steps in front of the target.";
CA_M01_RULO_DEFENSE_BLOCK = "Your equipped gear can block: press Zoom in the target room. You can also evade by moving sideways.";
CA_M01_RULO_DEFENSE_AIM = "With your ranged weapon, aiming with AltFire or Zoom in the target room counts as defense.";
CA_M01_RULO_DEFENSE_GREATSWORD = "With the greatsword, practice defense by evading. Stand in front of the target and walk a few steps sideways while keeping your view facing it. Zoom performs a circular sweep for triple the primary Air cost; it is an attack, so use sideways movement for this defense practice. Detail (F) marks the exercise when you have moved far enough.";
CA_M01_RULO_DEFENSE_EVADE = "Your current gear cannot block. In front of the target, walk a few steps sideways while keeping your view facing it. Turning the camera alone does not count. Detail (F) marks the exercise when you have moved far enough.";
CA_M01_RULO_CHECK_ADVANCED = "Land a charged hit, cast while moving, or reload a ranged weapon.";
CA_M01_RULO_CHECK_AIR = "Spend Air through attacks or running.";
CA_M01_RULO_CHECK_RECOVERY = "Recover Air after spending it.";

[es]
CA_M01_RULO_OFFER = "El arma está lista. Eso no significa que vos lo estés.\n\nYo ya le gané al Toro. Cuando terminó, Palomo me dijo: «Uno puede perder mucho después de haber ganado». Si entendés qué quiso decir, guardate la explicación para cuando salgamos.\n\nPrimero vamos a practicar. Después, Argento te dará la llave de plata.";
CA_M01_RULO_START = "Estoy listo para entrenar.";
CA_M01_RULO_PREPARE = "Preparar el arma y reponer la munición de práctica.";
CA_M01_RULO_CONTROLS = "Repasemos las prácticas.";
CA_M01_RULO_EQUIVALENTS = "¿Y si mi arma funciona de otra manera?";
CA_M01_RULO_PRACTICE = "El blanco está una planta más abajo de mi cuarto: primera habitación norte de la planta baja. Golpealo, probá las acciones de tu arma y aprendé a recuperar Aire. El Diario, en Misiones > Detalle (F), marca cada práctica.\n\n%DEFENSE%";
CA_M01_RULO_LESSON = "En el blanco: ataque principal (Fire), secundario (AltFire) y un ataque cargado: prepará la carga con Reload y después atacá. %DEFENSE% Gastá Aire y dejá que se recupere. Revisá las seis marcas en Detalle (F).";
CA_M01_RULO_EQUIVALENT_TEXT = "%DEFENSE%\n\nDistancia: acertá al blanco, apuntá con AltFire/Zoom y recargá con Reload; el apuntado cubre secundario y defensa. Lanza sin secundario: acertá mientras avanzás. Magia: acertá con ambos ataques y uno cargado o lanzado mientras te desplazás de costado; correr gasta Aire. Munición prestada: 24 proyectiles, repuestos durante el Toro si se agotan. Los sobrantes se devuelven al cerrar la prueba.";
CA_M01_RULO_KEY = "Pedile la llave de plata a Argento, en su cuarto del primer piso, al sudeste. Abrí la sala detrás del lugar donde despertaste. Los cuatro vamos a pelear con vos. Un compañero que cae queda fuera de combate hasta que termine el intento; si caés vos, el grupo se recupera y la prueba reinicia. Cuando ganemos, hablá conmigo ahí mismo.";
CA_M01_RULO_VICTORY = "Vos nos reuniste, y entre todos lo bajamos. Esa fuerza que tenés ya estaba ahí antes de que yo te enseñara nada. Pero hoy también lograste que cuatro cabezaduras te siguieran. Eso es saber liderar.\n\nQuizá Palomo se refería a eso: ganar sirve de poco si perdés a quienes tenés al lado.";
CA_M01_RULO_FINISH = "Terminamos la prueba.";
CA_M01_RULO_DONE = "Fuerza tenés, y sabés reunir a los demás. Cuidá a quienes te siguen. Palomo subió al segundo piso; cuando estés listo, buscalo allá.";
CA_M01_RULO_PRACTICE_READY = "Prácticas completas: pedile la llave de plata a Argento.";
CA_M01_RULO_PRACTICE_DONE = "Práctica registrada. Revisá Misiones > Detalle (F).";
CA_M01_RULO_AMMO_RESERVED = "La munición prestada se usa en la prueba y se devuelve a Rulo.";
CA_M01_RULO_AMMO_WEIGHT = "Necesitás liberar peso para recibir la munición de práctica.";
CA_M01_RULO_RETRY = "El grupo se recupera y vuelve a sus posiciones. Preparáte: el Toro vuelve a intentarlo.";
CA_M01_RULO_FIGHT_BEGIN = "Rulo, Ronnie, Argento y Caella se unen a vos. El recinto se cierra: enfrenten juntos al Toro.";
CA_M01_RULO_BULL_WON = "Toro derrotado. Volvé a hablar con Rulo. Si quedaba cupo de cuero, podés recogerlo.";
CA_M01_RULO_DETAIL_OFFER = "Hablá con Rulo en la primera habitación norte del primer piso (arriba, a la izquierda al entrar). El arma inicial ya está preparada y Ronnie recibió su espada.";
CA_M01_RULO_DETAIL_PRACTICE = "Entrená con el blanco de la primera habitación norte de la planta baja, directamente debajo del cuarto de Rulo. Completá las seis prácticas. Rulo puede preparar otra vez tu arma y la munición.";
CA_M01_RULO_DETAIL_KEY = "Las seis prácticas están completas. Pedile la llave de plata a Argento, en la habitación sudeste del primer piso. Elegí la opción sobre la llave.";
CA_M01_RULO_DETAIL_DOOR = "Abrí la puerta cerrada detrás del lugar donde despertaste y entrá. Rulo, Ronnie, Argento y Caella se reunirán con vos adentro antes de que ataque el Toro.";
CA_M01_RULO_DETAIL_FIGHT = "Combatí junto a los cuatro residentes. El Toro puede atacar a cualquiera del grupo. Esquivá la cornada y administrá Aire y Anima. Los compañeros caídos quedan fuera de combate hasta el final del intento. Si caés vos, el grupo y el Toro se recuperan; conservás las prácticas.";
CA_M01_RULO_DETAIL_RETURN = "Derrotaron al Toro juntos. El recinto está abierto y los cuatro compañeros se recuperan. Deja 12,5 kg de cuero de vaca utilizable. Hablá con Rulo, que está con vos: la prueba mostró tu fuerza innata y tu capacidad de liderar al grupo.";
CA_M01_RULO_DETAIL_DONE = "Rulo reconoció tu fuerza innata y tu capacidad para reunir y liderar a los cuatro residentes. El siguiente encuentro es con Palomo, en la habitación del segundo piso donde están todas las estaciones.";
CA_M01_RULO_CHECK_PRIMARY = "Acertar al blanco con Fire.";
CA_M01_RULO_CHECK_SECONDARY = "Secundario: AltFire; distancia, apuntado; lanza, golpe avanzando.";
CA_M01_RULO_CHECK_DEFENSE = "Bloqueo (Zoom), apuntado o esquiva lateral.";
CA_M01_RULO_CHECK_BLOCK = "Defensa: bloquear con Zoom en la sala del blanco.";
CA_M01_RULO_CHECK_AIM = "Defensa: apuntar con AltFire o Zoom en la sala del blanco.";
CA_M01_RULO_CHECK_EVADE = "Defensa: dar pasos de costado frente al blanco.";
CA_M01_RULO_DEFENSE_BLOCK = "Tu equipo permite bloquear: presioná Zoom en la sala del blanco. También podés esquivar desplazándote de costado.";
CA_M01_RULO_DEFENSE_AIM = "Con tu arma a distancia, apuntar con AltFire o Zoom en la sala del blanco cuenta como defensa.";
CA_M01_RULO_DEFENSE_GREATSWORD = "Con el mandoble, practicá la defensa esquivando. Frente al blanco, caminá unos pasos de costado sin dejar de mirarlo. Zoom hace un barrido circular por el triple de Aire del primario; es un ataque. Para esta defensa, usá el desplazamiento lateral. Detalle (F) marca la práctica cuando completás el recorrido.";
CA_M01_RULO_DEFENSE_EVADE = "Tu equipo actual no permite bloquear. Frente al blanco, caminá unos pasos de costado sin dejar de mirarlo. Girar la cámara sin desplazarte no cuenta. Detalle (F) marca la práctica cuando completás el recorrido.";
CA_M01_RULO_CHECK_ADVANCED = "Acertar cargado, lanzar magia desplazándose o recargar distancia.";
CA_M01_RULO_CHECK_AIR = "Gastar Aire con ataques o carrera.";
CA_M01_RULO_CHECK_RECOVERY = "Recuperar Aire después de gastarlo.";

// 4.33.0q: orientación propia de Argento y combate en grupo.
[enu default]
CA_M01_ARGENTO_NEXT_BEGIN = "Talk to me about how we can get out of here. Accept my proposal to start the trial.";
CA_M01_ARGENTO_NEXT_RESIDENTS = "Get Rulo, Ronnie and Caella to cooperate. If a conversation goes wrong, ask me for advice.";
CA_M01_ARGENTO_NEXT_RETURN = "All three have agreed to cooperate. Tell me how it went so we can finish this trial.";
CA_M01_ARGENTO_NEXT_KEY = "Your exercises are complete. I have the silver key: ask me about the locked door and I will hand it over. All four of us will join you against the Bull.";
CA_M01_RULO_PARTY_JOINED = "All four companions have joined you. Prepare to continue the fight.";
[es]
CA_M01_ARGENTO_NEXT_BEGIN = "Hablemos de cómo salir de acá. Aceptá mi propuesta para empezar la prueba.";
CA_M01_ARGENTO_NEXT_RESIDENTS = "Conseguí la ayuda de Rulo, Ronnie y Caella. Si una conversación sale mal, pedime un consejo.";
CA_M01_ARGENTO_NEXT_RETURN = "Los tres aceptaron colaborar. Contame cómo te fue para que terminemos esta prueba.";
CA_M01_ARGENTO_NEXT_KEY = "Ya completaste las prácticas. Yo tengo la llave de plata: preguntame por la puerta cerrada y te la doy. Los cuatro vamos a acompañarte contra el Toro.";
CA_M01_RULO_PARTY_JOINED = "Los cuatro compañeros ya están con vos. Preparáte para continuar el combate.";

// 4.33.0s: Palomo final y entrega persistente de la Caja.

[enu default]
CA_M01_PALOMO_FINAL = "Curious. Each of them showed you the path they knew, and you had the courtesy not to mistake any one of them for the whole road.";
CA_M01_PALOMO_FAVOR_ASK = "What now?";
CA_M01_PALOMO_IDEA_ASK = "Was all of this your idea?";
CA_M01_PALOMO_IDEA = "It would be vain to claim credit for a house, four wills and a particularly ill-tempered Bull. Let us say I made a few introductions.";
CA_M01_PALOMO_EXIT_ASK = "Why can they not leave?";
CA_M01_PALOMO_EXIT = "Perhaps because they still call a door an exit. Perhaps because the house is fickle. If you find a less uncomfortable answer, do share it.";
CA_M01_PALOMO_WHERE_ASK = "Will you tell me where we are now?";
CA_M01_PALOMO_WHERE = "On the second floor. I warned you that architecture would not help with ambitious questions.";
CA_M01_PALOMO_VOICE_ASK = "And the voice I heard?";
CA_M01_PALOMO_VOICE = "Hallucinations hate being ignored. The more useful they seem, the more careful you should be with them.";
CA_M01_PALOMO_OFFER = "I am going to ask you a favor. Look after this box while I attend to matters less convenient to carry.";
CA_M01_PALOMO_ACCEPT = "I will look after it. [Receive the Magic Box]";
CA_M01_PALOMO_MAGIC_ASK = "What is magical about it?";
CA_M01_PALOMO_MAGIC = "Mostly the name. Box was too short, and Immeasurable Relic attracts thieves.";
CA_M01_PALOMO_CONTENTS_ASK = "What does it contain?";
CA_M01_PALOMO_CONTENTS = "Space. An amount surprisingly difficult to store.";
CA_M01_PALOMO_WHY_ASK = "Why are you giving it to me?";
CA_M01_PALOMO_WHY = "Because you found things you need to carry, and because I found someone who still asks before obeying.";
CA_M01_PALOMO_RECEIVED = "It is in your care now. Do not judge what it can hold by the space it seems to occupy. The house should already have taught you to distrust such proportions.";
CA_M01_PALOMO_USE_ASK = "How do I store my belongings?";
CA_M01_PALOMO_USE = "The Box weighs ten kilograms; its contents weigh less when stored. Its space has a limit.\n\nOpen inventory with Tab, select an item and press C to store or retrieve it. Unequip it first if necessary. Loans and materials reserved for the trials stay outside. The Box itself stays with you.";
CA_M01_PALOMO_CAVE_ASK = "Where should I take it?";
CA_M01_PALOMO_CAVE = "Sometimes it helps to return to a place carrying something different. The cave beneath this mansion, for example.\n\nReturn to the passage you discovered with Caella, walk through the rear wall and take the lift down. The apparition floats in the centre of the cave, in front of the veins along its back wall. Approach it and examine it with the Box.";
CA_M01_PALOMO_WAIT = "There are still a few introductions to finish. I would not want a box to make you forget the people.";
CA_M01_PALOMO_BACK = "Back.";
CA_M01_PALOMO_DETAIL_BOX = "Palomo gave you the Magic Box. It weighs 10 kg and stores contents at reduced weight according to its capacity. In Inventory (Tab), select an item and press C to store or retrieve it; unequip it first if needed.\n\nPalomo suggested bringing it to the cave beneath the mansion. Use the passage discovered with Caella: walk through the rear wall and take the lift down. You can speak with him again on the second floor to review its use and the route.";
CA_M01_STATE_BOX_RECEIVED = "The Magic Box is yours";

[es]
CA_M01_PALOMO_FINAL = "Curioso. Cada uno le mostró el camino que conocía y usted tuvo la cortesía de no confundir ninguno con el camino completo.";
CA_M01_PALOMO_FAVOR_ASK = "¿Y ahora?";
CA_M01_PALOMO_IDEA_ASK = "¿Todo esto fue idea suya?";
CA_M01_PALOMO_IDEA = "Sería vanidoso adjudicarme una casa, cuatro voluntades y un Toro particularmente malhumorado. Digamos que hice algunas presentaciones.";
CA_M01_PALOMO_EXIT_ASK = "¿Por qué ellos no pueden salir?";
CA_M01_PALOMO_EXIT = "Tal vez porque todavía llaman salida a una puerta. Tal vez porque la casa es caprichosa. Si encuentra una respuesta menos incómoda, compártala.";
CA_M01_PALOMO_WHERE_ASK = "¿Ahora me va a decir dónde estamos?";
CA_M01_PALOMO_WHERE = "En el segundo piso. Le advertí que la arquitectura no colaboraría con preguntas ambiciosas.";
CA_M01_PALOMO_VOICE_ASK = "¿Y la voz que escuché?";
CA_M01_PALOMO_VOICE = "Las alucinaciones detestan ser ignoradas. Cuanto más útiles parezcan, más cuidado conviene tenerles.";
CA_M01_PALOMO_OFFER = "Voy a pedirle un favor. Cuide esta caja mientras atiendo asuntos menos cómodos de transportar.";
CA_M01_PALOMO_ACCEPT = "Voy a cuidarla. [Recibir la Caja Mágica]";
CA_M01_PALOMO_MAGIC_ASK = "¿Qué tiene de mágica?";
CA_M01_PALOMO_MAGIC = "Principalmente el nombre. Caja era demasiado breve y Reliquia Inconmensurable atrae ladrones.";
CA_M01_PALOMO_CONTENTS_ASK = "¿Qué contiene?";
CA_M01_PALOMO_CONTENTS = "Espacio. Una cantidad sorprendentemente difícil de guardar.";
CA_M01_PALOMO_WHY_ASK = "¿Por qué me la entrega?";
CA_M01_PALOMO_WHY = "Porque usted encontró cosas que necesita llevar y porque yo encontré a alguien que todavía pregunta antes de obedecer.";
CA_M01_PALOMO_RECEIVED = "Ahora está a su cuidado. No juzgue lo que puede guardar por lo que parece ocupar. La casa ya debería haberle enseñado a desconfiar de esas proporciones.";
CA_M01_PALOMO_USE_ASK = "¿Cómo guardo mis cosas?";
CA_M01_PALOMO_USE = "La Caja pesa diez kilos; el contenido pesa menos al guardarlo. Su espacio tiene un límite.\n\nAbra el inventario con Tab, elija un objeto y pulse C para guardarlo o retirarlo. Si lo tiene equipado, desequípelo primero. Los préstamos y materiales reservados para las pruebas permanecen fuera. La propia Caja permanece con usted.";
CA_M01_PALOMO_CAVE_ASK = "¿Adónde debería llevarla?";
CA_M01_PALOMO_CAVE = "A veces conviene volver a un sitio llevando algo distinto. La cueva bajo esta mansión, por ejemplo.\n\nVuelva al pasaje que descubrió con Caella, atraviese la pared del fondo y baje con el ascensor. La aparición flota en el centro de la cueva, delante de las vetas de la pared del fondo. Acérquese y examínela con la Caja.";
CA_M01_PALOMO_WAIT = "Todavía quedan algunas presentaciones por terminar. No quisiera que una caja le hiciera olvidar a las personas.";
CA_M01_PALOMO_BACK = "Volver.";
CA_M01_PALOMO_DETAIL_BOX = "Palomo te entregó la Caja Mágica. Pesa 10 kg y permite guardar contenido con peso reducido según su capacidad. En Inventario (Tab), seleccioná un objeto y pulsá C para guardarlo o retirarlo; desequipalo primero si hace falta.\n\nPalomo sugirió llevarla a la cueva bajo la mansión. Se llega por el pasaje descubierto con Caella: atravesá la pared del fondo y bajá con el ascensor. Podés volver a hablar con él en el segundo piso para repasar su uso y esa ruta.";
CA_M01_STATE_BOX_RECEIVED = "La Caja Mágica está en tu poder";

[enu default]
// 4.33.0t: captura y colección de Arcanos.
CA_JOURNAL_TAROT = "Tarot";
CA_TAROT_COLLECTION_COUNT = "Collection: %d / %d cards";
CA_TAROT_COLLECTION_EMPTY = "No captured Arcana yet. The Magic Box can reveal and capture an essence when you examine it.";
CA_TAROT_FOOL_NAME = "The Fool of the Pampas";
CA_TAROT_FOOL_DESCRIPTION = "Major Arcana 0. Air, Chaos, Freedom.\nA beginning without a certain path.\nIts +2% applies to all twelve primary attribute levels and preserves fractions.";
CA_TAROT_BONUS = "Tarot: +%d%% to attributes";
CA_M01_FOOL_STATE_FIND = "Examine the apparition in the cave";
CA_M01_FOOL_STATE_OBTAINED = "The Fool captured; the way out is ready";
CA_M01_FOOL_DETAIL_FIND = "Take the Magic Box into the cave beneath the mansion. Return to the passage you opened during Caella's trial, walk through the rear wall and take the lift down.\n\nAn apparition floats in the centre of the cave, in front of the veins along the back wall. Approach it and press Use to examine it with the Box.";
CA_M01_FOOL_DETAIL_REVEALED = "The Box revealed The Fool of the Pampas, Major Arcana 0. Examine the apparition again and choose Capture with the Magic Box. Stay close until the animation finishes.\n\nLeaving before it finishes interrupts the capture without consuming the essence. Once captured, its card and attribute bonus appear in the Journal's Tarot page.";
CA_M01_FOOL_DETAIL_DONE = "The Fool is in your collection. Its permanent +2% applies to all twelve primary attribute levels, preserving fractions. Check the Tarot and Character pages in the Journal.\n\nReturn to Palomo on the second floor and speak about the capture. You can also ask the four residents what they noticed.";
CA_M01_FOOL_REVEAL = "The Magic Box responds to the apparition. Its shape resolves into a card: The Fool of the Pampas.\n\nThe essence waits before you. You may capture it now, or leave it here and return.";
CA_M01_FOOL_CAPTURE = "Capture with the Magic Box.";
CA_M01_FOOL_LATER = "Leave it here for now.";
CA_M01_FOOL_INTERRUPTED = "Capture interrupted. Approach the essence to try again.";
CA_M01_FOOL_OBTAINED = "Arcana obtained: The Fool. +2% to attributes.";
CA_M01_FOOL_PALOMO = "It seems the Box was less empty than we both supposed. Or you were fuller. Simple measures warrant distrust.\n\nThe Fool has found a place in your collection. You may find its beginning easier to recognize than its destination.";
CA_M01_FOOL_COLLECTION_ASK = "What did the card change?";
CA_M01_FOOL_COLLECTION_HELP = "Look at Tarot in your Journal. A Major Arcana increases all twelve primary attribute levels by 2%; a Minor Arcana by 1%. These bonuses add together, and fractions are preserved.\n\nThe Fool already grants its bonus. You do not need to equip it or activate it.";
CA_M01_FOOL_ARGENTO = "I felt something settle into place. You brought us together, and now even that essence chose to follow you. I want to understand what that means as much as you do.";
CA_M01_FOOL_CAELLA = "So the apparition let you capture it... I could sense it, but I never managed that. Keep the Box close. I want to know how your bond with that essence develops.";
CA_M01_FOOL_RONNIE = "Something has changed since you went down there. Keep the weapon you made ready; choosing your next step deserves as much care as choosing a tool. The way out is at the back of the Bull room, on the ground floor.";
CA_M01_FOOL_RULO = "You already had strength when you arrived. Against the bull, you showed you could lead us too. Whatever that card adds, remember what you did with us. The door at the back of the Bull room now responds to you. I cannot make it do the same for me.";

[es]
// 4.33.0t: captura y colección de Arcanos.
CA_JOURNAL_TAROT = "Tarot";
CA_TAROT_COLLECTION_COUNT = "Colección: %d / %d cartas";
CA_TAROT_COLLECTION_EMPTY = "Todavía no capturaste ningún Arcano. La Caja Mágica permite revelar y capturar una esencia al examinarla.";
CA_TAROT_FOOL_NAME = "El Loco de las Pampas";
CA_TAROT_FOOL_DESCRIPTION = "Arcano Mayor 0. Aire, Caos, Libertad.\nUn comienzo sin un camino seguro.\nSu +2% se aplica al nivel de los doce atributos primarios y conserva decimales.";
CA_TAROT_BONUS = "Tarot: +%d%% a los atributos";
CA_M01_FOOL_STATE_FIND = "Examiná la aparición en la cueva";
CA_M01_FOOL_STATE_OBTAINED = "El Loco capturado; la salida está disponible";
CA_M01_FOOL_DETAIL_FIND = "Llevá la Caja Mágica a la cueva bajo la mansión. Volvé al pasaje que abriste en la prueba de Caella, atravesá la pared del fondo y bajá con el ascensor.\n\nUna aparición flota en el centro de la cueva, delante de las vetas de la pared del fondo. Acercate y pulsá Usar para examinarla con la Caja.";
CA_M01_FOOL_DETAIL_REVEALED = "La Caja reveló a El Loco de las Pampas, Arcano Mayor 0. Volvé a examinar la aparición y elegí Capturar con la Caja Mágica. Permanecé cerca hasta que termine la animación.\n\nAlejarte antes de que termine interrumpe la captura sin consumir la esencia. Una vez obtenida, la carta y su bonificación aparecen en la sección Tarot del Diario.";
CA_M01_FOOL_DETAIL_DONE = "El Loco está en tu colección. Su +2% permanente se aplica al nivel de los doce atributos primarios, conservando decimales. Podés revisarlo en Tarot y Personaje, en el Diario.\n\nVolvé con Palomo en el segundo piso y hablá sobre la captura. También podés hablar con los cuatro residentes para conocer sus reacciones.";
CA_M01_FOOL_REVEAL = "La Caja Mágica responde a la aparición. Su forma se define en una carta: El Loco de las Pampas.\n\nLa esencia espera frente a vos. Podés capturarla ahora o dejarla aquí y volver.";
CA_M01_FOOL_CAPTURE = "Capturar con la Caja Mágica.";
CA_M01_FOOL_LATER = "Dejarla aquí por ahora.";
CA_M01_FOOL_INTERRUPTED = "Captura interrumpida. Acercate a la esencia para volver a intentarlo.";
CA_M01_FOOL_OBTAINED = "Arcano obtenido: El Loco. +2% a los atributos.";
CA_M01_FOOL_PALOMO = "Parece que la caja estaba menos vacía de lo que ambos suponíamos. O usted más lleno. Conviene desconfiar de las medidas sencillas.\n\nEl Loco encontró un lugar en su colección. Quizá le resulte más fácil reconocer su comienzo que su destino.";
CA_M01_FOOL_COLLECTION_ASK = "¿Qué cambió con la carta?";
CA_M01_FOOL_COLLECTION_HELP = "Mire Tarot en su Diario. Un Arcano Mayor aumenta un 2% el nivel de los doce atributos primarios; un Arcano Menor, un 1%. Las bonificaciones se suman y se conservan los decimales.\n\nEl Loco ya concede su bonificación. No necesita equiparlo ni activarlo.";
CA_M01_FOOL_ARGENTO = "Sentí que algo quedó decidido. Lograste reunirnos y ahora hasta esa esencia eligió seguirte. Quiero entender qué significa tanto como vos.";
CA_M01_FOOL_CAELLA = "Así que la aparición se dejó capturar... Yo podía sentirla, pero nunca logré eso. Conservá la Caja cerca. Quiero saber cómo evoluciona tu vínculo con esa esencia.";
CA_M01_FOOL_RONNIE = "Algo cambió desde que bajaste. Tené preparada el arma que hiciste; elegir el próximo paso merece tanto cuidado como elegir una herramienta. La salida está al fondo de la sala del Toro, en planta baja.";
CA_M01_FOOL_RULO = "Fuerza ya tenías cuando llegaste. Contra el toro demostraste que también podés guiarnos. Sea lo que sea que sume esa carta, acordate de lo que hiciste con nosotros. La puerta al fondo de la sala del Toro ahora te responde. A mí sigue sin hacerme caso.";

[enu default]
CA_M01_FOOL_HINT_FIND = "Use the apparition to examine it with the Box.";
CA_M01_FOOL_HINT_DONE = "Your card and its bonus are shown in Tarot.";
[es]
CA_M01_FOOL_HINT_FIND = "Usá la aparición para examinarla con la Caja.";
CA_M01_FOOL_HINT_DONE = "La carta y su bonificación están en Tarot.";

// 4.33.0v: puerta de retorno y llegada a las alcantarillas.
[enu default]
CA_MAP02_SEWER_NAME = "Sewers — the labyrinth";
CA_M01_RETURN_TITLE = "The threshold";
CA_M01_RETURN_CONFIRM = "The path could close behind you. Leave the mansion?\n\nThe Box will carry the first weapon you made. Other equipment, materials, ammunition and supplies will remain here, including anything else stored in the Box. Your Tarot cards and learned recipes remain with you.";
CA_M01_RETURN_YES = "Yes. Cross.";
CA_M01_RETURN_NO = "No. Not yet.";
CA_M01_RETURN_ERROR = "The crossing could not be prepared. Your items remain with you; you can try again.";
CA_M01_RETURN_FINISH_TASK = "Finish or cancel your crafting task before crossing.";
CA_M01_RETURN_SOLO = "This story crossing is currently available only in a single-player game.";
CA_M01_RETURN_ASK = "Where does the way out lead?";
CA_M01_RETURN_PALOMO = "You found a way out. I did not promise it would lead where you expect, or remain there when you wished to return.\n\nAt the back of the room where you faced the Bull. Bring the Box. It has made room for the first weapon you fashioned; the other belongings will stay here. You may still say goodbye before crossing.";
CA_M01_RETURN_DETAIL_READY = "The way out is at the back of the Bull room, behind the silver-key door west of the place where you awoke. On the ground floor, enter that room, go to its back wall and use the marked door.\n\nYou can speak with Palomo upstairs or say goodbye to the residents first. Crossing requires explicit confirmation. Only the Box and the first weapon you crafted will travel; other carried and stored objects stay behind. Your Tarot collection and learned recipes are preserved.";
CA_M01_RETURN_DETAIL_CROSSING = "You chose to cross. Stay beside the marked door while the Box prepares the passage.";
CA_M01_RETURN_VOICE = "Now. Move before they discover you are still breathing.";
CA_M01_RETURN_LOOK = "Look around.";
CA_M01_RETURN_CONTINUE = "Continue.";
CA_M01_RETURN_COMPLETE = "Quest completed: Where the Lost Awaken.\n\nArcana obtained: The Fool.\n\nThe Box is beside you. Your first weapon is inside; retrieve and equip it from Inventory. You remember the recipes you learned.";
CA_M01_RETURN_DETAIL_COMPLETE = "You left the mansion and awoke in the sewers. The Box and your first crafted weapon made the crossing. Other belongings stayed behind.\n\nOpen Inventory to retrieve and equip the weapon from the Box. Your Tarot collection, attribute bonus and learned recipes remain with you.";

// 4.33.0v: puerta de retorno y llegada a las alcantarillas.
[es]
CA_MAP02_SEWER_NAME = "Alcantarillas — el laberinto";
CA_M01_RETURN_TITLE = "El umbral";
CA_M01_RETURN_CONFIRM = "El camino podría cerrarse detrás de vos. ¿Abandonar la mansión?\n\nLa Caja llevará la primera arma que fabricaste. El resto del equipo, materiales, munición y provisiones quedarán aquí, incluido lo demás que guardaste en la Caja. Conservás tus cartas del Tarot y las recetas aprendidas.";
CA_M01_RETURN_YES = "Sí. Cruzar.";
CA_M01_RETURN_NO = "No. Todavía no.";
CA_M01_RETURN_ERROR = "No se pudo preparar el cruce. Conservás tus objetos y podés volver a intentarlo.";
CA_M01_RETURN_FINISH_TASK = "Terminá o cancelá tu tarea de fabricación antes de cruzar.";
CA_M01_RETURN_SOLO = "Este cruce narrativo está disponible por ahora en una partida individual.";
CA_M01_RETURN_ASK = "¿Adónde lleva la salida?";
CA_M01_RETURN_PALOMO = "Encontró una salida. No prometí que condujera al lugar que espera ni que siguiera allí cuando quisiera volver.\n\nAl fondo de la sala donde enfrentó al Toro. Lleve la Caja: ha hecho lugar para la primera arma que fabricó; las otras pertenencias quedarán aquí. Todavía puede despedirse antes de cruzar.";
CA_M01_RETURN_DETAIL_READY = "La salida está al fondo de la sala del Toro, detrás de la puerta de plata al oeste del lugar donde despertaste. En planta baja, entrá en esa sala, avanzá hasta la pared del fondo y usá la puerta marcada.\n\nPodés hablar con Palomo arriba o despedirte de los residentes antes. Cruzar requiere confirmación. Viajarán la Caja y tu primera arma fabricada; los demás objetos, tanto llevados como almacenados, quedan atrás. Conservás el Tarot y las recetas aprendidas.";
CA_M01_RETURN_DETAIL_CROSSING = "Elegiste cruzar. Permanecé junto a la puerta marcada mientras la Caja prepara el paso.";
CA_M01_RETURN_VOICE = "Ahora sí. Movete antes de que descubran que seguís respirando.";
CA_M01_RETURN_LOOK = "Mirar alrededor.";
CA_M01_RETURN_CONTINUE = "Continuar.";
CA_M01_RETURN_COMPLETE = "Misión completada: Donde despiertan los perdidos.\n\nArcano obtenido: El Loco.\n\nLa Caja está con vos. Tu primera arma está dentro: recuperala y equipala desde Inventario. Recordás las recetas que aprendiste.";
CA_M01_RETURN_DETAIL_COMPLETE = "Dejaste la mansión y despertaste en las alcantarillas. La Caja y tu primera arma fabricada cruzaron con vos. Las otras pertenencias quedaron atrás.\n\nAbrí Inventario para recuperar y equipar el arma desde la Caja. Conservás tu colección de Tarot, la bonificación a los atributos y las recetas aprendidas.";


[default]
// 4.33.0w: mantenimiento opcional de la primera arma.
CA_M01_REPAIR_ASK = "How do I maintain my weapon?";
CA_M01_REPAIR_INTRO = "Making it was only the beginning. Inspect the first weapon you crafted: its condition shows the wear. If it is damaged, you can learn to repair that same piece. If it is intact, there is nothing to repair yet.\n\nThis practice is optional. You can continue with Rulo or leave when the way opens.";
CA_M01_REPAIR_STEPS_ASK = "Where and how do I repair it?";
CA_M01_REPAIR_STEPS = "Select your damaged weapon in Inventory and unequip it. Upstairs, in the second-floor room, all twelve workstations line the back and side walls, leaving room for the dining table. Use the Workbench; in Trades, press F to repair the selected piece. Check the required materials first.\n\nThe cost follows its actual wear. Keep the same piece; making another weapon is not repairing it.";
CA_M01_REPAIR_COST_ASK = "What happens to materials and pauses?";
CA_M01_REPAIR_COST = "The workbench reserves the materials it needs. Closing the interface or leaving pauses the work; it does not cancel it. You choose whether to resume or cancel. A saved game keeps the task.\n\nUse 100% in every layer: your repair allowance covers the damage we inspected. Wood and fiber: entrance garden. Metals and gems: cave. Leather: chest. Ask to borrow my gathering sword if needed, then return it here.";
CA_M01_REPAIR_DONE = "You restored the same weapon instead of replacing it. That is the lesson: inspect its wear, plan your materials and keep your equipment working.\n\nThe optional practice is complete. You can ask me to review the steps whenever you need.";
CA_M01_REPAIR_DETAIL = "Optional practice — Ronnie: repair your first crafted weapon if it is worn. Select it in Inventory and unequip it. Use the Workbench in the second-floor room, then press F in Trades. The existing task must finish. Closing or leaving pauses it; only you cancel it. This does not block Rulo or the exit.";
CA_M01_REPAIR_DETAIL_DONE = "Optional practice completed: you repaired your first crafted weapon.";


[es]
// 4.33.0w: mantenimiento opcional de la primera arma.
CA_M01_REPAIR_ASK = "¿Cómo mantengo mi arma?";
CA_M01_REPAIR_INTRO = "Fabricarla fue el principio. Inspeccioná la primera arma que hiciste: su condición muestra el desgaste. Si está dañada, podés aprender a reparar esa misma pieza. Si está intacta, todavía no necesita reparación.\n\nEsta práctica es opcional. Podés seguir con Rulo o irte cuando se abra el camino.";
CA_M01_REPAIR_STEPS_ASK = "¿Dónde y cómo la reparo?";
CA_M01_REPAIR_STEPS = "Seleccioná el arma dañada en Inventario y desequipala. En la habitación del segundo piso están las doce estaciones distribuidas entre el fondo y los costados, dejando espacio para la mesa. Usá el Banco de Trabajo; en Oficios, F repara la pieza seleccionada. Revisá los materiales necesarios primero.\n\nEl coste depende del desgaste real. Conservá la pieza: fabricar otra arma no equivale a repararla.";
CA_M01_REPAIR_COST_ASK = "¿Qué pasa con los materiales y las pausas?";
CA_M01_REPAIR_COST = "El banco reserva los materiales necesarios. Cerrar la interfaz o alejarte pausa el trabajo; no lo cancela. Vos decidís si lo retomás o cancelás. La partida guardada conserva la tarea.\n\nUsá 100% en cada capa: el cupo de reparación cubre el daño que revisamos. Madera y fibra: jardín. Metales y gemas: cueva. Cuero: cajón. Si necesitás mi espada para recolectar, pedímela y después devolvela aquí.";
CA_M01_REPAIR_DONE = "Recuperaste la misma arma en lugar de reemplazarla. Esa es la lección: mirar el desgaste, prever los materiales y mantener tu equipo en condiciones.\n\nLa práctica opcional está completa. Podés pedirme que repasemos los pasos cuando lo necesites.";
CA_M01_REPAIR_DETAIL = "Práctica opcional — Ronnie: repará tu primera arma fabricada si tiene desgaste. Seleccioná esa pieza en Inventario y desequipala. Usá el Banco de Trabajo de la habitación del segundo piso; en Oficios, pulsá F. Debe terminar la tarea real. Cerrar o alejarte la pausa; sólo vos la cancelás. No bloquea a Rulo ni la salida.";
CA_M01_REPAIR_DETAIL_DONE = "Práctica opcional completada: reparaste tu primera arma fabricada.";

// 4.33.0x: práctica opcional de necesidades.
[default]
CA_M01_NEEDS_ASK = "How do I eat and drink?";
CA_M01_NEEDS_INTRO = "Higher reserves are better. Constitution divides Hunger/Thirst loss, including the cost of natural Health and Air recovery; Resilience divides Sleep loss. At 100, the corresponding cost is one third. Any reserve at 10% or less drains life and stops natural healing. This optional practice gives food and water once, lowering reserves above 90% to 90%.";
CA_M01_NEEDS_START = "Let us practice.";
CA_M01_NEEDS_PRACTICE = "Open Inventory with Tab, select a food or water ration and press Enter to consume it. Retrieve it first if it is in the Box. Food restores one point per second for ten seconds. Water also acts for ten seconds, but its recovery depends on your body mass: one liter covers all thirst per 50 kg. Watch the bars after closing the menu. Quest Detail tracks each use separately; no return visit is required.";
CA_M01_NEEDS_SAFE_ASK = "What about water in the world?";
CA_M01_NEEDS_SAFE = "The potable pool behind the mansion restores one Thirst point per second with your head submerged, even without a container. My workshop dialogue offers a canteen. Empty or partly filled containers carried outside the Box fill on immersion if you can carry the missing water. Drink through Inventory; wait ten seconds between sips.";
CA_M01_NEEDS_RETRY = "Check the ration delivery.";
CA_M01_NEEDS_BACK = "Back to the practice.";
CA_M01_NEEDS_DONE = "You used food and water when your reserves needed them. Keep watching the bars and allow time for recovery. The practice is complete; you can carry on.";
CA_M01_NEEDS_DETAIL = "Optional Ronnie practice: food and water. Tab > Inventory, select a ration and press Enter. Retrieve it from the Box first if needed. If weight prevented delivery, free space and ask Ronnie to check it.";
CA_M01_NEEDS_FOOD_DONE = "Food: correctly consumed.";
CA_M01_NEEDS_FOOD_WAIT = "Food: consume a ration with reserves below 100%.";
CA_M01_NEEDS_WATER_DONE = "Water: correctly consumed.";
CA_M01_NEEDS_WATER_WAIT = "Water: consume a ration with reserves below 100%.";

// 4.33.0x: práctica opcional de necesidades.
[es]
CA_M01_NEEDS_ASK = "¿Cómo me alimento y bebo?";
CA_M01_NEEDS_INTRO = "Cuanto más altas las reservas, mejor. Constitución divide el gasto de Hambre/Sed, incluido el coste de regenerar vida y Aire; Resiliencia, el de Sueño. Al 100, el gasto correspondiente es un tercio. Una reserva al 10% o menos drena vida y detiene su regeneración. Esta práctica opcional entrega alimento y agua una vez, bajando las reservas superiores al 90% hasta ese valor.";
CA_M01_NEEDS_START = "Hagamos la práctica.";
CA_M01_NEEDS_PRACTICE = "Abrí Inventario con Tab, seleccioná la ración de alimento o agua y pulsá Enter para consumirla. Si está en la Caja, recuperala primero. El alimento recupera un punto por segundo durante diez segundos. El agua también actúa durante diez segundos, pero recupera según tu masa corporal: un litro cubre toda la sed por cada 50 kg. Mirá las barras al cerrar el menú. Detalle registra cada uso por separado; no hace falta volver para completarlo.";
CA_M01_NEEDS_SAFE_ASK = "¿Y el agua del entorno?";
CA_M01_NEEDS_SAFE = "La piscina potable detrás de la mansión recupera un punto de Sed por segundo con la cabeza sumergida, incluso sin recipiente. En mi charla de talleres te ofrezco una cantimplora. Al sumergirte se llenan o completan los recipientes fuera de la Caja, si podés cargar el agua faltante. Bebé desde Inventario; esperá diez segundos entre sorbos.";
CA_M01_NEEDS_RETRY = "Comprobar la entrega de las raciones.";
CA_M01_NEEDS_BACK = "Volvamos a la práctica.";
CA_M01_NEEDS_DONE = "Ya usaste alimento y agua cuando tus reservas lo necesitaban. Acordate de mirar las barras y dar tiempo a la recuperación. La práctica está completa; podés seguir con lo tuyo.";
CA_M01_NEEDS_DETAIL = "Práctica opcional de Ronnie: alimento y agua. Tab > Inventario, seleccionar ración y Enter. Recuperarla antes si está en la Caja. Si faltó una entrega por carga, liberá espacio y pedile comprobarla.";
CA_M01_NEEDS_FOOD_DONE = "Alimento: consumido correctamente.";
CA_M01_NEEDS_FOOD_WAIT = "Alimento: falta consumir una ración con la reserva por debajo del 100%.";
CA_M01_NEEDS_WATER_DONE = "Agua: consumida correctamente.";
CA_M01_NEEDS_WATER_WAIT = "Agua: falta consumir una ración con la reserva por debajo del 100%.";

// 4.33.0y: Aire y movimiento.
[default]
CA_M01_AIR_ASK = "How do I manage my Air?";
CA_M01_AIR_INTRO = "Running consumes Air; walking lets you advance calmly and recover it. We can practice without exhausting you: run until you spend 1% of your maximum Air, then recover that amount naturally. This is optional. You do not need to jump, fight or enter water.";
CA_M01_AIR_START = "Let us practice Air management.";
CA_M01_AIR_PRACTICE = "Find a clear corridor in the mansion. Move with Run active until Quest Detail asks you to recover Air. You can use short stretches without exhausting yourself. With Always Run enabled, holding the run key switches to walking.";
CA_M01_AIR_RECOVER = "You have observed the running cost. Walk or stand still on dry ground to recover that small amount. Natural recovery uses some food and water reserves; replenish them first if empty. An energy drink does not replace this step.";
CA_M01_AIR_DONE = "You have seen running consume Air and recovered it naturally. You do not need to move at full speed all the time: walking also gets you ahead. The practice is complete.";
CA_M01_AIR_DETAIL_RUN = "Optional Air practice: run in a clear corridor to spend 1% of your maximum. Short stretches accumulate; exhaustion is unnecessary.";
CA_M01_AIR_DETAIL_RECOVER = "Optional Air practice: walk or stop on dry ground to recover the observed amount naturally. Food and water reserves are needed; no return visit is required.";
CA_M01_AIR_DETAIL_DONE = "Optional Air practice completed: running and natural recovery.";

// 4.33.0y: Aire y movimiento.
[es]
CA_M01_AIR_ASK = "¿Cómo administro mi Aire?";
CA_M01_AIR_INTRO = "Correr consume Aire; caminar te permite avanzar con calma y recuperarlo. Podemos practicar sin agotarte: corré hasta gastar un 1% de tu Aire máximo y después recuperá esa cantidad de forma natural. Es opcional. No tenés que saltar, pelear ni meterte al agua.";
CA_M01_AIR_START = "Hagamos la práctica de Aire.";
CA_M01_AIR_PRACTICE = "Buscá un pasillo despejado de la mansión. Movete con Correr activo hasta que Detalle te pida recuperar Aire. No hace falta agotarte: podés hacerlo en tramos cortos. Si usás Correr siempre, la tecla de correr alterna a caminar mientras la mantenés.";
CA_M01_AIR_RECOVER = "Ya observaste el gasto al correr. Ahora caminá o quedate quieto en suelo seco hasta recuperar esa pequeña cantidad. La recuperación natural consume algo de alimento y agua; si tus reservas están vacías, atendelas primero. Una bebida energética no sustituye esta parte.";
CA_M01_AIR_DONE = "Ya comprobaste cómo correr consume Aire y cómo recuperarlo naturalmente. No hace falta moverse siempre al máximo: caminar también te permite avanzar. La práctica está completa.";
CA_M01_AIR_DETAIL_RUN = "Práctica opcional de Aire: corré en un pasillo despejado hasta gastar un 1% de tu máximo. Se acumulan tramos cortos; no hace falta agotarte.";
CA_M01_AIR_DETAIL_RECOVER = "Práctica opcional de Aire: caminá o detenete en suelo seco para recuperar naturalmente la cantidad observada. Necesitás reservas de alimento y agua; no hace falta volver con Ronnie.";
CA_M01_AIR_DETAIL_DONE = "Práctica opcional de Aire completada: correr y recuperar naturalmente.";

// 4.33.0z: carga y decisiones de inventario.
[default]
CA_M01_LOAD_ASK = "How do I manage my load?";
CA_M01_LOAD_INTRO = "You carry %LOADKG% kg and your capacity is %LOADCAP% kg. Load alone multiplies Air consumption by %LOADAIR%. Being able to lift something does not mean carrying everything is useful. At 75% you are overloaded and extra weight raises the cost more steeply. We can practice reducing your load; it is optional.";
CA_M01_LOAD_START = "I want to practice reducing my load.";
CA_M01_LOAD_PRACTICE = "Keep your first weapon. In Tab > Inventory select a spare item you own: D leaves it on the ground. If you have the Box, C stores it; this counts if carried weight decreases. Loans and reserved materials keep their restrictions. Quest Detail records the actual reduction. With no spare items, you can continue without this practice.";
CA_M01_LOAD_DONE = "You reduced your load through Inventory. You can pick up what you left when convenient. You now carry %LOADKG% kg out of %LOADCAP% kg; the load Air factor is %LOADAIR%. You do not have to carry everything in one trip.";
CA_M01_LOAD_DETAIL = "Optional load practice: keep your first weapon. In Inventory, D drops a spare item; C stores it in the Box if owned. Carried weight must decrease. Overloading and a return visit are unnecessary.";
CA_M01_LOAD_DETAIL_DONE = "Optional load practice completed: you lightened your inventory.";

// 4.33.0z: carga y decisiones de inventario.
[es]
CA_M01_LOAD_ASK = "¿Cómo organizo mi carga?";
CA_M01_LOAD_INTRO = "Llevás %LOADKG% kg y tu capacidad es %LOADCAP% kg. Sólo por esa carga, el consumo de Aire se multiplica por %LOADAIR%. Poder levantar algo no significa que convenga llevarlo todo. Desde el 75% estás sobrecargado y el peso adicional aumenta más el gasto. Podemos practicar cómo aligerarte; es opcional.";
CA_M01_LOAD_START = "Quiero practicar cómo aligerarme.";
