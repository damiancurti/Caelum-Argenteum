// +10 minutos conserva su alias de consola para depuración; el Diario usa T
// únicamente para el avance rápido durante descanso o fabricación.

// Tab abre el Diario definitivo. El automapa nativo se conserva en M para
// exteriores y depuración; ambas acciones siguen apareciendo en Controles.
alias ca_time_skip "netevent ca_skip_open"

// BEGIN GENERATED CONTROL DEFAULTS
// Sólo el primer inicio del lanzador o un reset solicitado aplican el preset.
alias ca_controls_defaults "bind Tab ca_journal_toggle; bind M togglemap; bind B +user2; bind R +reload; bind F +zoom; bind T +user3; bind Y ca_time_skip; unmapbind M"
alias ca_controls_reset "resetb2defaults; ca_controls_defaults"

